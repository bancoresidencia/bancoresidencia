# ==============================================================================
# BANCO RESIDÊNCIA — MODELO DE VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# Copie este arquivo para .env.local para desenvolvimento local:
#   cp .env.example .env.local
#
# NUNCA envie chaves reais ou dados sensíveis para o repositório Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Banco de Dados, Autenticação, RLS e Storage)
# ------------------------------------------------------------------------------
# URL pública do projeto Supabase (Ex: https://ezluharxlmlqhdkqrjbz.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Chave publicável do projeto Supabase, com acesso controlado por RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Chave secreta do projeto Supabase, exclusiva do backend
SUPABASE_SECRET_KEY=sb_secret_...

# Credenciais para Supabase CLI e GitHub Actions CI/CD (Migrações e Tipos)
# Token de acesso pessoal gerado em https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_...

# Senha do banco Postgres (definida na criação do projeto ou em Database Settings)
SUPABASE_DB_PASSWORD=your_db_password

# ------------------------------------------------------------------------------
# 2. AUTENTICAÇÃO GOOGLE (OAuth 2.0)
# ------------------------------------------------------------------------------
# Credenciais da integração direta com o Google Agenda. O login usa o provedor Google do Supabase Auth.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# ------------------------------------------------------------------------------
# 3. PAGAMENTOS & ASSINATURAS (Mercado Pago)
# ------------------------------------------------------------------------------
# Chaves de integração da plataforma Mercado Pago
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=APP_USR-...
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-...
MERCADO_PAGO_WEBHOOK_SECRET=your_mercadopago_webhook_secret

# ------------------------------------------------------------------------------
# 4. INTELIGÊNCIA ARTIFICIAL (Google Gemini API)
# ------------------------------------------------------------------------------
# Chave da API do Google AI Studio para resolução e curadoria de questões
GEMINI_API_KEY=AIzaSy...

# ------------------------------------------------------------------------------
# 5. APLICAÇÃO WEB
# ------------------------------------------------------------------------------
# Na Vercel (Production), defina https://hippocampusresidencia.com.br sem barra final.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Segredo de produção para tickets de sessão e cotas de visitantes
GUEST_QUOTA_SECRET=

# Credenciais opcionais e independentes para automações autorizadas
# Bearer das rotas administrativas com suporte a M2M
ADMIN_M2M_TOKEN=
# Cabeçalho x-admin-key da geração de resumos
ADMIN_API_KEY=

