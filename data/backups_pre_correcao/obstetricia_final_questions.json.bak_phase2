  {
    "id": "2afefb2d-bcda-4337-94bf-2fad81a46250",
    "code": "HMDI-2018-OBS-3954",
    "institution": "HMDI - Hospital e Maternidade Dona Iris (GO)",
    "banca": "HMDI",
