  {
    "id": "4688a3ec-978b-4da0-b5a1-a8028c94334c",
    "code": "SESRJ-2020-OBS-6339",
    "institution": "SES-RJ - Secretaria de Estado de Saúde do Rio de Janeiro",
    "banca": "SES-RJ",
    "year": 2020,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Trabalho de Parto e Parto",
    "foco": "Manejo Ativo do Terceiro Período do Parto",
    "subfoco": "Manejo Ativo do Terceiro Período do Parto: Componentes e Sequência",
    "difficulty": "Fácil",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "Visando à prevenção da hemorragia puerperal, são propostas medidas conhecidas em conjunto como manejo ativo do 3º período, cujo fator mais importante é a utilização de medicamentos. De acordo com a OMS, o agente de 1ª linha proposto para prevenção da hemorragia pós-parto é:",
    "options": [
      {
        "letter": "A",
        "text": "ácido tranexâmico"
      },
      {
        "letter": "B",
        "text": "metilergonovina"
      },
      {
        "letter": "C",
        "text": "misoprostol"
      },
      {
        "letter": "D",
        "text": "ocitocina"
      }
    ],
    "correct_answer": "D",
    "commentary": "Solução\nGabarito: D) ocitocina\nA prevenção de HPP inicia-se no pré-natal pela identificação dos fatores de risco e tentativa\nde corrigir ou evitá-los. Deve-se tratar anemia durante a gestação e suspender em tempo\nhábil para o parto medicações que aumentem o risco de sangramento, como AAS e Heparina.\nNo parto, a prevenção da HPP é feita com o manejo ativodo terceiro período (dequitação) e a\nobservação rigorosa do quarto período (Greenberg) para todas as parturientes.\nO manejo ativo de terceiro período tem como principal medida o uso universal da ocitocina\napós o nascimento, na dose de 10UI intramuscular. A ocitocina é a medicação de primeira\nescolha na prevenção da hemorragia pós-parto, reduzindo em mais de 50% os quadros de\nHPP.\nAdemais, outras medidas de prevenção para HPP também devem ser realizadas, as quais\nestão listadas na tabela a seguir:",
    "images": [],
    "correctAnswer": "D",
    "is_official": true,
    "provenance": "oficial_drive_tematico",
    "official_book": "Hemorragia Pós-Parto (HPP).pdf.json"
  },
