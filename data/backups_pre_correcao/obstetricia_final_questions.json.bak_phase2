      "https://bxedpdmgvgatjdfxgxij.supabase.co/storage/v1/object/public/questoes/revalida/2024/primigesta-41-anos-de-idade-gestacao-apos-ciclo-natural-indu-01.webp",
      "https://bxedpdmgvgatjdfxgxij.supabase.co/storage/v1/object/public/questoes/revalida/2024/primigesta-41-anos-de-idade-gestacao-apos-ciclo-natural-indu-02.webp"
    ],
    "correctAnswer": "C",
