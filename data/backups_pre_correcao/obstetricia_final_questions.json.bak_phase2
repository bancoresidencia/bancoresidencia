        "letter": "B",
        "text": "maior ou igual a 126mg/dL antes de 20 semanas de gestação ou entre 24-28 semanas de gestação e ao menos um valor alterado no TOTG"
      },
      {
        "letter": "C",
        "text": "maior ou igual a 126mg/dL antes de 20 semanas de gestação ou entre 24-28 semanas de gestação e glicemia de 2 horas igual ou maior que 200mg/dL no TOTG"
      },
      {
        "letter": "D",
        "text": "de 92-125mg/dL antes de 20 semanas de gestação ou entre 24-28 semanas de gestação e ao menos um valor alterado no teste oral de tolerância à glicose (TOTG)"
      }
