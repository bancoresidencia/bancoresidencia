  {
    "id": "96a70b2d-5c44-4609-9a65-e660169a1eea",
    "code": "HIAEEINSTEIN-2024-OBS-9890",
    "institution": "HIAE/Einstein - Hospital Israelita Albert Einstein (SP)",
    "banca": "HIAE/Einstein",
