  {
    "id": "811aae57-de96-494b-8868-9746c5bd9dde",
    "code": "HSI-2019-OBS-9307",
    "institution": "HSI - Hospital Santa Isabel (SE)",
    "banca": "HSI",
    "year": 2019,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Abortamento",
    "foco": "Gravidez Ectópica",
    "subfoco": "Fatores de Risco e Epidemiologia",
    "difficulty": "Fácil",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "Gravidez ectópica é patologia muito frequente, de repercussão clínica grave, caracterizada pela implantação e fertilização do ovo fora do útero. (TAFURI, Celso Pedro. Patologia Ginecológica e Obstétrica - complicações clínicas. MEDSI. Rio de Janeiro. Patologia do ovário. Cap. 9. p. 155.). Sobre \"Gravidez ectópica\", marque a alternativa incorreta.",
    "options": [
      {
        "letter": "A",
        "text": "A maioria das gestações ectópicas, cerca de 96%, localizam-se na trompa uterina."
      },
      {
        "letter": "B",
        "text": "Um pequeno percentual das gestações ectópicas se localiza no ovário e cavidade peritoneal, colo do útero."
      },
      {
        "letter": "C",
        "text": "A tuba uterina é a sede menos frequente das gestações ectópicas."
      },
      {
        "letter": "D",
        "text": "Na tuba uterina, as gestações ectópicas localizam-se mais frequentemente no seu terço distal (ampola)."
      },
      {
        "letter": "E",
        "text": "Como possíveis mecanismos que favorecem a gravidez tubária têm: fatores que retardam a passagem do ovo através da tuba; fatores que aumentam a receptividade tubária; fatores que derivam do próprio concepto."
      }
    ],
    "correct_answer": "C",
    "commentary": "",
    "images": [],
    "correctAnswer": "C",
    "isAnulada": false
  },
