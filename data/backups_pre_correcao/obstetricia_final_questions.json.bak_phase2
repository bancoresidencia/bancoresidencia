  {
    "id": "8977a388-fd73-4a89-ab9d-5d5576850f3f",
    "code": "UFRGSHCPA-2023-OBS-9893",
    "institution": "UFRGS/HCPA - Hospital de Clínicas de Porto Alegre (RS)",
    "banca": "UFRGS/HCPA",
    "year": 2023,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
