  {
    "id": "29ffc7e1-186f-4425-88d3-8863ce190dbc",
    "code": "UFGHC-2019-OBS-11494",
    "institution": "UFG/HC - Hospital das Clínicas da UFG - Goiânia (GO)",
    "banca": "UFG/HC",
    "year": 2019,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Intercorrências Clínicas na Gestação",
    "foco": "ITU e Pielonefrite na Gestação",
    "subfoco": "Bacteriúria Assintomática: Diagnóstico e Tratamento",
    "difficulty": "Médio",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "Leia o caso clínico a seguir. J.E. de 25 anos, G2P1A0, idade gestacional de 31 semanas, apresenta duas contrações em dez minutos, regulares, colo uterino com 3 cm de dilatação, fino e bolsa amniótica íntegra. Nesse caso, qual é a mais provável causa dessa intercorrência?",
    "options": [
      {
        "letter": "A",
        "text": "Inserção fúndica da placenta."
      },
      {
        "letter": "B",
        "text": "Apresentação anômala."
      },
      {
        "letter": "C",
        "text": "Intervalo interpartal maior que dois anos."
      },
      {
        "letter": "D",
        "text": "Infecção geniturinária."
      }
    ],
    "correct_answer": "D",
    "commentary": "Solução\nGabarito: D) Infecção geniturinária.\nGABARITO: ALTERNATIVA D\nO que o examinador quer saber: sobre causas e fator de risco para parto prematuro.\nO principal fator de risco para prematuridade é o histórico prévio de parto prematuro. O\nantecedente de parto prematuro aumenta em 25% a chance de um novo parto pré-termo e\ngeralmente este ocorre na mesma idade gestacional.\nA etiologia infecciosa do trabalho de parto prematuro merece destaque, principalmente, as\ninfecções do sistema genital e urinário. Bacteriúria assintomática, cistite e pielonefrite foram\nrelacionadas ao maior risco de prematuridade, assim como as infecções do trato genital,\nsobretudo, pelas seguintes bactérias: estreptococos do grupo B, Chlamydia trachomatis,\nGardnerella vaginalis, Neisseria gonorrhoeae, Trichomonas vaginalis, Ureaplasma e\nHaemophilus influenzae e Treponema pallidum. Outras infecções, como a doença periodontal,\ntambém podem desencadear o TPP.\nOutros fatores de risco para prematuridade estão listados na tabela abaixo:\n19. Prematuridade e Trabalho de parto prematuro (TPP)\nExtensivo - Obstetrícia \t285/291\nT.ME/MEDOPEN - ACERVO MÉDICO GRATUITO",
    "images": [],
    "correctAnswer": "D",
    "is_official": true,
    "provenance": "oficial_drive_tematico",
    "official_book": "Prematuridade e Trabalho de parto prematuro (TPP).pdf.json"
  },
