      },
      {
        "letter": "C",
        "text": "infecção aguda inicial - repetir a sorologia após duas semanas;"
      },
      {
        "letter": "D",
        "text": "infecção subaguda ou recente - solicitar teste de avidez."
      }
    ],
    "correct_answer": "D",
