  {
    "id": "53b9cf61-acef-4c2d-b63a-b269fbd97451",
    "code": "IOG-2019-OBS-4267",
    "institution": "IOG - Instituto de Olhos de Goiânia",
    "banca": "IOG",
    "year": 2019,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
