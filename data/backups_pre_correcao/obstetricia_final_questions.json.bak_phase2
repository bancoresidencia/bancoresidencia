  {
    "id": "55efd6da-53a8-4649-b5fa-25dbce12eaaa",
    "code": "UNICAMPHC-2015-OBS-3452",
    "institution": "UNICAMP/HC - Hospital de Clínicas da Unicamp - Campinas (SP)",
    "banca": "UNICAMP/HC",
