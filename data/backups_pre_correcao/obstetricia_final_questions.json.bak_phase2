      },
      {
        "letter": "C",
        "text": "Não realizar qualquer tratamento."
      },
      {
        "letter": "D",
        "text": "Iniciar esquema tríplice com pirimetamina, sulfadiazina e ácido folínico."
      },
      {
        "letter": "E",
        "text": "Iniciar ácido folínico, espiramicina e sulfadiazina."
      }
    ],
    "correct_answer": "D",
