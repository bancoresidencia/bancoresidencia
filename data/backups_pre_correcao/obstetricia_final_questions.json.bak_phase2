  {
    "id": "2a9b43a7-94cd-4678-8c1f-7e1a1a7cd5e2",
    "code": "HMG-2017-OBS-3538",
    "institution": "HMG - Hospital Municipal Dr. Mário Gatti - Campinas (SP)",
    "banca": "HMG",
    "year": 2017,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
