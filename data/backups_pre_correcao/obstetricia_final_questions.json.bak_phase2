      "https://bxedpdmgvgatjdfxgxij.supabase.co/storage/v1/object/public/questoes/revalida/2023/paciente-de-41-anos-retorna-em-consulta-de-pre-natal-trazend-01.webp"
    ],
    "correctAnswer": "C",
