    "tema": "Trabalho de Parto e Parto",
    "foco": "Partograma e Interpretação",
    "subfoco": "Monitorização Fetal e Partograma",
    "difficulty": "Fácil",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "Observando-se o partograma, pode-se afirmar que (CONFORME IMAGEM DO CADERNO DE QUESTÕES):",
    "options": [
      {
        "letter": "A",
        "text": "Foi iniciado na fase latente do trabalho de parto, sendo inadequado."
      },
      {
        "letter": "B",
        "text": "Se trata de um período expulsivo prolongado."
      },
      {
