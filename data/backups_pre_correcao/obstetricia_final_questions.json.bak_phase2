  {
    "id": "aae56406-fb93-4749-87e2-0f16cf378c17",
    "code": "HOSBOS-2025-OBS-5759",
    "institution": "HOS/BOS - Hospital Oftalmológico de Sorocaba - Banco de Olhos (SP)",
    "banca": "HOS/BOS",
    "year": 2025,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Intercorrências Clínicas na Gestação",
    "foco": "Diabetes Gestacional",
    "subfoco": "Rastreamento e Diagnóstico do Diabetes Gestacional (TOTG)",
    "difficulty": "Fácil",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "R.T.B., 29 anos, primigesta, idade gestacional de 11 semanas, veio à segunda consulta de pré-natal com glicemia de jejum de 92 mg/dL. IMC de 24 kg/m², sorologia para toxoplasmose: IgG positivo e IgM positivo. Teste de avidez para IgG 90%. Nega comorbidades.Sobre o caso, assinale a alternativa correta.",
    "options": [
      {
        "letter": "A",
        "text": "Trata-se de diabetes gestacional."
      },
      {
        "letter": "B",
        "text": "Trata-se de overt diabetes."
      },
      {
        "letter": "C",
        "text": "Trata-se de diabetes tipo II."
      },
      {
        "letter": "D",
        "text": "Deve-se solicitar TOTG (Teste Oral de Tolerância à Glicose) com idade gestacional de 24 – 28 semanas."
      },
      {
        "letter": "E",
        "text": "Deve-se introduzir insulina com 2/3 da dose pela manhã."
      }
    ],
    "correct_answer": "",
    "commentary": "Solução\nGabarito: A) Trata-se de diabetes gestacional.\nGABARITO: ALTERNATIVA A\nO que o examinador quer saber: sobre diabetes na gestação.\nO diagnóstico de diabetes na gestação é feito conforme o organograma a seguir.\n14. Diabetes Mellitus na Gestação\nExtensivo - Obstetrícia \t186/329\nT.ME/MEDOPEN - ACERVO MÉDICO GRATUITO\n\nDiante de uma gestante com diagnostico de diabetes gestacional, a primeira conduta é\ninstituir dieta e exercício físico. Além disso, a gestante deve fazer o controle diário dos índices\nglicêmicos (perfil glicêmico) pela aferição da glicemia capilar diária. Essas medidas são\nessenciais para avaliar se a terapêutica com dieta e atividade física está sendo eficaz para o\ncontrole glicêmico.\nOs valores das glicemias considerado normais são:\nA insulinoterapia é indicada quando não se alcança adequado controle glicêmico, isto é, na\npresença de duas ou mais medidas de glicemia acima da meta, avaliadas após 7 a 14 dias de\nterapia não farmacológica Ou se circunferência abdominal fetal ≥ percentil 75º na\nultrassonografia de 3º trimestre (29 e 33 semanas de gestação), independente dos valores\nglicêmicos. Aceita-se também como critério para a introdução de insulina a presença de 30\n-50% dos controles glicêmicos alterados em 7 dias de dieta e exercício físico.",
    "images": [],
    "correctAnswer": "A",
    "is_official": true,
    "provenance": "oficial_drive_tematico",
    "official_book": "Diabetes Mellitus na Gestação.pdf.json"
  },
