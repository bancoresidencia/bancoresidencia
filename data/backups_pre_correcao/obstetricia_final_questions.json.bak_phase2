  {
    "id": "bb866a36-8180-4ce8-ac83-b6eed02460a6",
    "code": "SESDF-2020-OBS-3204",
    "institution": "SES-DF - Secretaria de Estado de Saúde do Distrito Federal",
    "banca": "SES-DF",
    "year": 2020,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Intercorrências Clínicas na Gestação",
    "foco": "ITU e Pielonefrite na Gestação",
