    "statement": "Qual é a indicação mais comum para a realização de uma cesariana eletiva?",
    "options": [
      {
        "letter": "A",
        "text": "Placenta prévia."
      },
      {
        "letter": "B",
        "text": "Pré-eclâmpsia leve."
