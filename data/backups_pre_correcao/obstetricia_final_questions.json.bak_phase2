        "letter": "B",
        "text": "corticoterapia para maturação pulmonar fetal; resolução da gestação por via alta, após 48 horas, com antibioticoprofilaxia."
      },
      {
        "letter": "C",
        "text": "corticoterapia para maturação pulmonar fetal; profilaxia para sepse neonatal por estreptococo beta-hemolítico; aguardo do trabalho de parto."
      },
      {
        "letter": "D",
        "text": "indução do trabalho de parto; profilaxia para sepse neonatal por estreptococo beta- hemolítico; antibioticoterapia de largo espectro."
      }
