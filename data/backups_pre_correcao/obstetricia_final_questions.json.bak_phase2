  {
    "id": "5234d2ba-a7a8-47ae-97a5-bdeee29eb61a",
    "code": "HIAEEINSTEIN-2022-OBS-4399",
    "institution": "HIAE/Einstein - Hospital Israelita Albert Einstein (SP)",
    "banca": "HIAE/Einstein",
    "year": 2022,
    "tipo_prova": "Prova 1",
