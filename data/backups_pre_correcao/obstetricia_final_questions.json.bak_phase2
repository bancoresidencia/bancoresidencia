  {
    "id": "e1c3a15d-a210-4c60-9cf7-ed611978a0b2",
    "code": "UNIVERSIDADE-2017-OBS-4635",
    "institution": "Universidade de Ribeirão Preto",
    "banca": "Universidade de Ribeirão Preto",
    "year": 2017,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Trabalho de Parto e Parto",
    "foco": "Partograma e Interpretação",
    "subfoco": "Diagnóstico de Distocia e Anormalidades da Progressão",
    "difficulty": "Difícil",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "Observe o partograma. De acordo com os dados, sabendo-se que o trabalho de parto evoluiu para parto normal, pode-se afirmar que:",
    "options": [
      {
        "letter": "A",
        "text": "A expulsão ocorreu na zona 1 do partograma."
      },
      {
        "letter": "B",
        "text": "A expulsão ocorreu na zona 2 do partograma."
      },
      {
        "letter": "C",
        "text": "A expulsão ocorreu na zona 3 do partograma."
      },
      {
        "letter": "D",
        "text": "A expulsão ocorreu na zona 4 do partograma."
      },
      {
        "letter": "E",
        "text": "É impossível definir a zona de expulsão."
      }
    ],
    "correct_answer": "A",
    "commentary": "Solução\nGabarito: A) A expulsão ocorreu na zona 1 do partograma.\nGABARITO: ALTERNATIVA A\nO que o examinador quer saber: Se você sabe conhece as zonas do partograma.\nO partograma é a forma de representar graficamente o trabalho de parto permitindo que seja\nadequadamente acompanhado, avaliado e documentado. Ele é preenchido em colunas que\nrepresentam cada hora do trabalho de parto e em linhas que se associam a dilatação e altura\nda apresentação específicas. A dilatação cervical é representada classicamente por um\ntriângulo e a altura da apresentação por uma circunferência. O registro da variedade de\nposição é feito pela representação do ponto de referência da apresentação em relação à\npelve materna dentro da circunferência. O partograma pode ser dividido em três zonas:\nZona I – antes de atingir a linha de alerta.\nZona II – entre a linha de alerta e a linha de ação.\nZona III – após ultrapassar a linha de ação.\nEspera-se que você seja capaz reconhecer as zonas do partograma destacadas abaixo ao\navaliar o partograma apresentado na questão, e saber avaliar o momento em que ocorreu o\nparto para escolher a alternativa correta.\n7. Partograma e Distocia\nExtensivo - Obstetrícia \t317/345\nT.ME/MEDOPEN - ACERVO MÉDICO GRATUITO",
    "images": [
      "https://bxedpdmgvgatjdfxgxij.supabase.co/storage/v1/object/public/questoes/revalida/2017/observe-o-partograma-de-acordo-com-os-dados-sabendo-se-que-o-01.webp"
    ],
    "correctAnswer": "A",
    "is_official": true,
    "provenance": "oficial_drive_tematico",
    "official_book": "Partograma e Distocia.pdf.json"
  },
  {
    "id": "f1b9b253-ee6e-4009-87ca-f6821d019a19",
