  {
    "id": "f96db1bc-336f-4ba5-bb40-bdad2ca5e3f3",
    "code": "FJG-2020-OBS-10673",
    "institution": "FJG - Fundação João Goulart / SMS Rio de Janeiro",
    "banca": "FJG",
