  {
    "id": "cc6b11a6-6f9b-4238-af58-d292a1987f41",
    "code": "INEPREVALIDA-2025-OBS-13856",
    "institution": "INEP Revalida - Exame Nacional de Revalidação de Diplomas Médicos",
    "banca": "INEP Revalida",
