        "letter": "A",
        "text": "V, F, V, F, F."
      },
      {
        "letter": "B",
        "text": "V, F, F, V, F."
      },
      {
        "letter": "C",
        "text": "F, V, F, V, V."
      },
      {
        "letter": "D",
        "text": "F, V, V, F, F."
      },
      {
        "letter": "E",
        "text": "F, V, V, F, V."
      }
    ],
    "correct_answer": "C",
    "commentary": "",
    "images": [],
    "correctAnswer": "C",
    "isAnulada": false
