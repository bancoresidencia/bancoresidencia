    "difficulty": "Médio",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "P.L.S., 37 anos, primigesta, IG cronológica de 7 semanas e 6 dias, veio para o primeiro exame de ultrassom nesta gestação. Identificada imagem uterina, conforme figura a seguir.De acordo com a imagem, assinale o diagnóstico correto.",
    "options": [
      {
        "letter": "A",
        "text": "Gestação única."
      },
      {
        "letter": "B",
        "text": "Gestação gemelar dicoriônica e diamniótica."
      },
      {
        "letter": "C",
        "text": "Gestação gemelar dicoriônica e monoamniótica."
      },
      {
        "letter": "D",
        "text": "Gestação gemelar monocoriônica e diamniótica."
      },
      {
        "letter": "E",
        "text": "Gestação gemelar monocoriônica e monoamniótica."
      }
