    "correctAnswer": "C",
    "isAnulada": false
  },
  {
    "id": "e2bcdd98-c9a4-4e99-a961-15208c153085",
    "code": "UNICAMPHC-2014-OBS-13199",
    "institution": "UNICAMP/HC - Hospital de Clínicas da Unicamp - Campinas (SP)",
    "banca": "UNICAMP/HC",
    "year": 2014,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
