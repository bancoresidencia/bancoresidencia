      {
        "letter": "C",
        "text": "As alternativas II e III estão corretas."
      },
      {
        "letter": "D",
        "text": "As alternativas II e IV estão corretas."
      },
      {
        "letter": "E",
        "text": "As alternativas I, II e III estão corretas."
      }
    ],
    "correct_answer": "C",
    "commentary": "",
