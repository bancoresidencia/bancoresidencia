  {
    "id": "ca355ac6-391e-49ff-aee2-f5614a6bc902",
    "code": "HUGGUNIRIO-2019-OBS-1720",
    "institution": "HUGG/UNIRIO - Hospital Universitário Gaffrée e Guinle (RJ)",
