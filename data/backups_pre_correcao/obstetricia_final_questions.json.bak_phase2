      },
      {
        "letter": "C",
        "text": "20ª semana de gestação."
      },
      {
        "letter": "D",
        "text": "32ª semana de gestação."
      },
      {
        "letter": "E",
        "text": "40ª semana de gestação."
      }
    ],
