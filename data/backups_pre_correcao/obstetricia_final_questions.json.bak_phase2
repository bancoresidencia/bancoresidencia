        "text": "Cesárea imediata."
      },
      {
        "letter": "B",
        "text": "Inibição do trabalho de parto."
      },
      {
        "letter": "C",
        "text": "Condução do parto."
      },
      {
        "letter": "D",
        "text": "Cesárea após corticoterapia."
      }
    ],
    "correct_answer": "C",
