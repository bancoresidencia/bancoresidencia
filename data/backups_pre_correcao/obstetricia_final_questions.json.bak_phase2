    "statement": "Hormônio lactogênio placentário, durante a gravidez, é responsável por um efeito:",
    "options": [
      {
        "letter": "A",
        "text": "Diurético"
      },
      {
        "letter": "B",
        "text": "Alérgico."
      },
      {
        "letter": "C",
        "text": "Estimulante do apetite."
      },
      {
        "letter": "D",
        "text": "Diabetogênico."
      },
