      {
        "letter": "A",
        "text": "Miotamponagem, tríplice gradiente descendente."
      },
      {
        "letter": "B",
        "text": "Secundamento, desprendimento do feto."
      },
      {
        "letter": "C",
        "text": "Elevação térmica, perda do tampão mucoso."
      },
      {
        "letter": "D",
        "text": "Miotamponagem, indiferença uterina."
      }
    ],
    "correct_answer": "D",
    "commentary": "",
