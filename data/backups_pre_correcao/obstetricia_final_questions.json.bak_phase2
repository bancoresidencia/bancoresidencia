  {
    "id": "a5ab4bbc-9bbf-4c36-92b2-a5e85b812a1f",
    "code": "UNESPHCFMB-2025-OBS-3508",
    "institution": "UNESP/HCFMB - Hospital das Clínicas de Botucatu (SP)",
