  {
    "id": "47816d4a-3d61-4fc7-a4bf-117fe0c2928f",
    "code": "SANTACASADEM-2021-OBS-11230",
    "institution": "Santa Casa de Marília (SP)",
    "banca": "Santa Casa de Marília (SP)",
    "year": 2021,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Intercorrências Clínicas na Gestação",
    "foco": "HIV na Gestação e Profilaxias",
    "subfoco": "Via de Parto em Gestante HIV Positivo",
    "difficulty": "Fácil",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "Uma gestante em trabalho de parto, G2 P1 normal, idade gestacional de 38 semanas, é admitida na maternidade com 5 cm de dilatação e contrações regulares, bolsa íntegra. Ao realizar o toque, o obstetra observa, na vulva, lesão ativa por herpes, fase vesicular. A conduta nesse caso é:",
    "options": [
      {
        "letter": "A",
        "text": "indicar cesárea."
      },
      {
        "letter": "B",
        "text": "realizar parto normal, evitando episiotomia no local da lesão."
      },
      {
        "letter": "C",
        "text": "realizar parto normal, com analgesia mais precoce pelo efeito somatório de dor que a lesão herpética causa na parturiente."
      },
      {
        "letter": "D",
        "text": "realizar parto normal, com o cuidado de não romper a bolsa precocemente."
      }
    ],
