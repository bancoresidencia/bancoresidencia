  {
    "id": "c1c7163d-33f5-46ba-9a45-8abdc61238b0",
    "code": "UFMTREVALIDA-2022-OBS-14015",
    "institution": "UFMT Revalida - Universidade Federal de Mato Grosso",
    "banca": "UFMT Revalida",
