  {
    "id": "a65a8714-9bb7-4556-bfd0-3fdd8c5af497",
    "code": "UFPAHUJBB-2020-OBS-6545",
    "institution": "UFPA/HUJBB - Hospital Universitário João de Barros Barreto - Belém (PA)",
    "banca": "UFPA/HUJBB",
