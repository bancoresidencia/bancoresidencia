  {
    "id": "88ecefcb-f3ae-4a03-a679-31448fd8e42c",
    "code": "SESPE-2024-OBS-10978",
    "institution": "SES-PE - Secretaria de Estado de Saúde de Pernambuco",
    "banca": "SES-PE",
    "year": 2024,
