      },
      {
        "letter": "C",
        "text": "Prescrever oseltamivir 75mg de 12/12 h por 5 dias e manter acompanhamento ambulatorial."
      },
      {
        "letter": "D",
        "text": "Iniciar uso de Loratadina 10 mg de 12/12h por 7 dias e manter acompanhamento ambulatorial."
      }
    ],
