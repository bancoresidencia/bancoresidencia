  {
    "id": "8f477307-3b77-4955-878e-575c03af3ecb",
    "code": "SMSCAMPOGRAN-2019-OBS-1289",
    "institution": "SMS Campo Grande - Secretaria Municipal de Saúde (MS)",
    "banca": "SMS Campo Grande",
    "year": 2019,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Intercorrências Clínicas na Gestação",
    "foco": "Sífilis na Gestação: Diagnóstico e Tratamento",
