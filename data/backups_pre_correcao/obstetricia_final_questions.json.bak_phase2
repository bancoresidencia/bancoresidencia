  {
    "id": "86cf75cc-1bb9-4dbe-a6f0-d1ef0e56e10c",
    "code": "SMSSP-2023-OBS-2047",
    "institution": "SMS-SP - Secretaria Municipal de Saúde de São Paulo",
    "banca": "SMS-SP",
