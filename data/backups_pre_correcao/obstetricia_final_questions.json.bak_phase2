      {
        "letter": "C",
        "text": "Iniciar antibiótico de amplo espectro e corticoterapia fetal."
      },
      {
        "letter": "D",
        "text": "Suspender o acompanhamento e repetir sorologia em 4 semanas."
      },
      {
        "letter": "E",
        "text": "Realizar exsanguíneotransfusão intrauterina imediata."
      }
    ],
    "correct_answer": "A",
