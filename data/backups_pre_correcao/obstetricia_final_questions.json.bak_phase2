  {
    "id": "72fccd6d-491c-4d09-9872-3bc4544814d5",
    "code": "UFPBHULW-2016-OBS-10798",
    "institution": "UFPB/HULW - Hospital Universitário Lauro Wanderley - João Pessoa (PB)",
    "banca": "UFPB/HULW",
