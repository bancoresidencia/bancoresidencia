      },
      {
        "letter": "C",
        "text": "Septo uterino parcial. Metroplastia histeroscópica."
      },
      {
        "letter": "D",
        "text": "Útero didelfo. Indicar realização de fertilização in vitro."
      }
    ],
    "correct_answer": "",
