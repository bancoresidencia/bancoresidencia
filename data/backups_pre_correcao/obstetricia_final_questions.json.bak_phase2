      },
      {
        "letter": "C",
        "text": "Iniciar ampicilina, 2,0g, EV, seguida por 1,0g, EV, de 4 em 4h."
      },
      {
        "letter": "D",
        "text": "Não há necessidade de se prescrever antibiótico."
      }
    ],
    "correct_answer": "D",
    "commentary": "",
    "images": [],
    "correctAnswer": "D",
