  {
    "id": "d9bd5b12-b1f3-4493-be0d-c5d85af86463",
    "code": "HUGGUNIRIO-2019-OBS-0834",
    "institution": "HUGG/UNIRIO - Hospital Universitário Gaffrée e Guinle (RJ)",
    "banca": "HUGG/UNIRIO",
