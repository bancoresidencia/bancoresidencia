  {
    "id": "155e333a-8f6e-4c41-80f1-7b134921bce1",
    "code": "HEDA-2026-OBS-13582",
    "institution": "HEDA - Hospital Estadual Dirceu Arcoverde (PI)",
    "banca": "HEDA",
    "year": 2026,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Intercorrências Clínicas na Gestação",
    "foco": "Diabetes Gestacional",
    "subfoco": "Insulinoterapia na Gestação",
    "difficulty": "Médio",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "Andrea primigesta, com 38 anos, é internada com 39 semanas e 5 dias para programação de indução do parto. Apresenta histórico de hipertensão arterial crônica, em bom controle clínico com metildopa, e diabetes mellitus gestacional, em uso de esquema basal-bolus com insulina NPH e insulina regular. No momento da admissão, encontra-se em bom estado geral, normotensa, sem intercorrências clínicas, com apresentação cefálica, batimentos cardíacos fetais adequados e colo uterino favorável, com dilatação inicial. Está programada a oferta de dieta leve no dia da indução, com monitorização glicêmica capilar. Diante desse cenário, assinale a alternativa que indica a prescrição mais adequada de insulina para esse período:",
    "options": [
      {
        "letter": "A",
        "text": "Suspender insulina regular e manter apenas insulina NPH em dose reduzida."
      },
      {
        "letter": "B",
        "text": "Reduzir pela metade as doses de NPH e manter doses fixas de insulina regular."
      },
      {
        "letter": "C",
        "text": "Utilizar apenas insulina regular conforme valores de glicemia capilar."
      },
      {
        "letter": "D",
        "text": "Suspender toda a insulinoterapia até o início do trabalho de parto ativo."
      },
      {
        "letter": "E",
        "text": "Manter esquema habitual completo de NPH e regular, associado a soro glicosado."
      }
    ],
    "correct_answer": "C",
    "commentary": "",
    "images": [],
    "correctAnswer": "C",
    "gabaritoHomologado": true,
    "gabaritoFonte": "MedBrave_Strict_Match",
    "gabaritoCruzadoEm": "2026-10-21T02:57:50.089Z"
  },
  {
    "id": "72a745fa-f444-4c2b-a12a-a67cf126d8a1",
    "code": "HEDA-2026-OBS-13583",
    "institution": "HEDA - Hospital Estadual Dirceu Arcoverde (PI)",
    "banca": "HEDA",
    "year": 2026,
