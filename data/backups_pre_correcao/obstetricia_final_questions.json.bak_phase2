  {
    "id": "c623f60d-8d03-449b-a631-d1f21c4e71b1",
    "code": "IFFFIOCRUZ-2019-OBS-4231",
    "institution": "IFF/Fiocruz - Instituto Fernandes Figueira (RJ)",
    "banca": "IFF/Fiocruz",
    "year": 2019,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Hemorragias Obstétricas",
    "foco": "Hemorragia Pós-parto",
    "subfoco": "Atonia Uterina: Fatores de Risco e Prevenção",
    "difficulty": "Fácil",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "O secundamento ou terceiro período do parto é o estádio onde ocorre o descolamento, descida e expulsão da placenta e de suas páreas para fora das vias genitais. O quarto período compreende a primeira hora após a saída da placenta. Esses dois períodos são importantes pelo risco de complicações hemorrágicas, frequente causa de morbimortalidade materna. Marque a opção VERDADEIRA.",
    "options": [
      {
        "letter": "A",
        "text": "O manejo ativo no secundamento com massagem uterina, uterotônico e tração controlada do cordão deve ser realizado rotineiramente."
      },
      {
        "letter": "B",
        "text": "No tratamento da hemorragia pós-parto, a histerectomia está indicada após a falha do tratamento clínico com uterotônicos e massagem uterina."
      },
      {
        "letter": "C",
        "text": "Atonia uterina e coagulopatia são duas causas mais comuns de hemorragia pós parto."
      },
      {
        "letter": "D",
        "text": "Hemorragia pós-parto por ruptura uterina deve ser tratada de forma consecvadora com administração de uterotônicos."
      }
    ],
    "correct_answer": "A",
    "commentary": "",
    "images": [],
    "correctAnswer": "A",
    "isAnulada": false
  },
