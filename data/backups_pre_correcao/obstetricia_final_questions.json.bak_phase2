      },
      {
        "letter": "C",
        "text": "Início de Sulfato de Magnésio e prednisona para maturação pulmonar, com interrupção em 24h ."
      },
      {
        "letter": "D",
        "text": "Administração de hidralazina endovenosa para controle pressórico e biometria fetal em 24 hs."
      },
      {
        "letter": "E",
        "text": "Início de Sulfato de Magnésio, cesárea com anestesia geral e transfusão de plaquetas."
      }
