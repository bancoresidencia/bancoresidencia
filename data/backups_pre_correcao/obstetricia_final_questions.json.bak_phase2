  {
    "id": "8cf21169-848d-4b4b-8762-14f2711f3b45",
    "code": "HPEV-2023-OBS-3953",
    "institution": "HPEV - Hospital Professor Edmundo Vasconcelos (SP)",
    "banca": "HPEV",
    "year": 2023,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Doenças Hipertensivas na Gestação",
    "foco": "Hipertensão Arterial Crônica na Gestação",
