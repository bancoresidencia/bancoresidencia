  {
    "id": "5003470a-2552-47b0-812c-890a00a97015",
    "code": "HIS-2025-OBS-4234",
    "institution": "HIS - Hospital Infantil Sabará (SP)",
    "banca": "HIS",
    "year": 2025,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Assistência Pré-natal",
