        "text": "6 semanas e 4 dias; 01.11.24."
      },
      {
        "letter": "B",
        "text": "7 semanas e 2 dias; 30.10.24."
      },
      {
        "letter": "C",
        "text": "6 semanas e 5 dias; 26.10.24."
      },
