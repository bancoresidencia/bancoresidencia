      {
        "letter": "A",
        "text": "Realizar amniotomia para desencadear o trabalho de parto."
      },
      {
        "letter": "B",
        "text": "Conduta expectante, pois a paciente já está com 37 semanas."
      },
      {
        "letter": "C",
        "text": "Deve proceder a interrupção da gestação por via alta."
      },
      {
        "letter": "D",
        "text": "Internar a paciente, controlar o sangramento, os sinais vitais e interromper com maturidade fetal."
      },
      {
        "letter": "E",
        "text": "Indução do parto com ocitocina."
      }
    ],
    "correct_answer": "C",
    "commentary": "",
    "images": [],
    "correctAnswer": "C",
    "isAnulada": false
  },
