    "code": "CENTROUNIVER-2024-OBS-0978",
    "institution": "Centro Universitário FMABC",
    "banca": "Centro Universitário FMABC",
    "year": 2024,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
