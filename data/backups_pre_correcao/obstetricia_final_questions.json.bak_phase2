  {
    "id": "605140b1-4137-4a1f-93aa-a47af39d4b48",
    "code": "USPHCFMUSP-2020-OBS-0873",
    "institution": "USP/HCFMUSP - Hospital das Clínicas da FMUSP (SP)",
    "banca": "USP/HCFMUSP",
    "year": 2020,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Doenças Hipertensivas na Gestação",
    "foco": "Hipertensão Arterial Crônica na Gestação",
