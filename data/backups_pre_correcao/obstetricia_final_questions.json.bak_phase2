      },
      {
        "letter": "C",
        "text": "Acesso venoso / hidralazina endovenosa / sulfato de magnésio / resolução."
      },
      {
        "letter": "D",
        "text": "Acesso venoso / hidralazina endovenosa / sulfato de magnésio / exames laboratoriais e aguardar completar 39 semanas de gestação."
      }
    ],
    "correct_answer": "A",
    "commentary": "",
    "images": [],
    "correctAnswer": "A",
    "gabaritoHomologado": true,
