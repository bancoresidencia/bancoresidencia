  {
    "id": "23f4944d-515c-4349-86f0-f4ac46997058",
    "code": "UFRGSHCPA-2022-OBS-5686",
    "institution": "UFRGS/HCPA - Hospital de Clínicas de Porto Alegre (RS)",
