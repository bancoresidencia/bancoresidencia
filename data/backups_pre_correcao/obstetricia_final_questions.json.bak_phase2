  {
    "id": "d61f71a9-cc17-44d8-a84e-930baa8c3c2f",
    "code": "UEL-2023-OBS-9764",
    "institution": "UEL - Hospital Universitário de Londrina (PR)",
    "banca": "UEL",
    "year": 2023,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Intercorrências Clínicas na Gestação",
    "foco": "Streptococcus do Grupo B: Rastreio e Profilaxia Intraparto",
    "subfoco": "Rastreamento de Colonização por GBS",
    "difficulty": "Médio",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "Assinale a alternativa que apresenta, corretamente, o patógeno que pode aumentar o risco de parto prematuro pela secreção de hialuronidase.",
    "options": [
      {
        "letter": "A",
        "text": "Escherichia coli."
      },
      {
        "letter": "B",
        "text": "Estreptococo do grupo B."
      },
      {
        "letter": "C",
        "text": "Proteus mirabilis."
      },
      {
        "letter": "D",
        "text": "Peptoestreptococo."
      },
      {
        "letter": "E",
        "text": "Gardnerella vaginalis."
      }
    ],
    "correct_answer": "B",
    "commentary": "Gabarito Oficial [UEL 2023 Q#25]: Correta ✅. Adequada. O Streptococcus agalactiae (estreptococo β-hemolítico do grupo B) representa um patógeno de relevância clínica substancial, particularmente na população neonatal, sendo capaz de desencadear quadros infecciosos severos incluindo bacteremia e meningoencefalite. Na população adulta, manifesta-se através de infecções do sistema genitourinário e processos endocárdicos. Este microrganismo destaca-se pela expressão significativa de hialuronidase, enzima proteolítica que promove a degradação do ácido hialurônico presente na matriz extracelular, potencializando a penetração e disseminação tissular do agente. A hialuronidase constitui um determinante de virulência fundamental em processos infecciosos de alta gravidade, como a fasciíte necrotizante, propiciando a progressão acelerada da enfermidade e a evasão dos mecanismos de defesa imunológica. É relevante destacar que o entendimento do papel desempenhado pela hialuronidase nas infecções estreptocócicas pode nortear abordagens diagnósticas, condutas terapêuticas e o desenvolvimento de novas modalidades de intervenção antivirulência.",
    "images": [],
    "correctAnswer": "B",
    "isAnulada": false,
    "source": "questmed"
  },
  {
