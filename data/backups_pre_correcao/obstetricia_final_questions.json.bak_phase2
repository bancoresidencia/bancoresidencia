  {
    "id": "c3bcba7c-1904-443d-a432-5ddedfc62bb0",
    "code": "UFESHUCAM-2019-OBS-7624",
    "institution": "UFES/HUCAM - Hospital Universitário Cassiano Antônio Moraes - Vitória (ES)",
    "banca": "UFES/HUCAM",
