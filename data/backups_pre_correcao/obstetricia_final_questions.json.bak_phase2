  {
    "id": "d7eae987-21b9-4201-9ca2-d7653a03da02",
    "code": "HOSBOS-2025-OBS-10000",
    "institution": "HOS/BOS - Hospital Oftalmológico de Sorocaba - Banco de Olhos (SP)",
    "banca": "HOS/BOS",
