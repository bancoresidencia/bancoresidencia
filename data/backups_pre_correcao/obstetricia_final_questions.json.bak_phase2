  {
    "id": "e0e92fd9-a4da-4c47-9529-067c8f4ea11a",
    "code": "USPHCRP-2020-OBS-10396",
    "institution": "USP/HCRP - Hospital das Clínicas de Ribeirão Preto (SP)",
