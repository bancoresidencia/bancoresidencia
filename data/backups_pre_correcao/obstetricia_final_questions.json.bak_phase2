  {
    "id": "9d97788a-5f54-4f86-9726-ba5686195939",
    "code": "UFMTREVALIDA-2023-OBS-14046",
    "institution": "UFMT Revalida - Universidade Federal de Mato Grosso",
    "banca": "UFMT Revalida",
    "year": 2023,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Trabalho de Parto e Parto",
    "foco": "Amniorrexe Prematura: Corioamnionite e Profilaxias",
    "subfoco": "Amniorrexe Prematura: Corioamnionite e Profilaxias",
    "difficulty": "Fácil",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "A rotura prematura das membranas ovulares é definida como a rotura espontânea das membranas coriônica e amniótica antes do início do trabalho de parto. Sobre esta importante condição complicadora da gravidez, analise as seguintes afirmativas:I. O período de latência é inversamente relacionado com a idade gestacional em que ocorreu a rotura das membranas.II. São complicações fetais hipoplasia pulmonar, prematuridade e infecção neonatal.III. Como a prematuridade aumenta a morbidade e a mortalidade neonatais, a inibição do trabalho de parto prematuro nestes casos leva a uma melhor taxa de sobrevida neonatal.IV. A antibioticoprofilaxia aumenta o período de latência e diminui a morbidade e a letalidade neonatais. Estão corretas as afirmativas",
    "options": [
      {
        "letter": "A",
        "text": "II, III e IV, apenas."
      },
      {
        "letter": "B",
        "text": "I, III e IV, apenas."
      },
      {
        "letter": "C",
        "text": "I, II e IV, apenas."
      },
      {
        "letter": "D",
        "text": "I, II e III, apenas."
      }
    ],
    "correct_answer": "C",
    "commentary": "",
    "images": [],
    "correctAnswer": "C",
    "gabaritoHomologado": true,
    "gabaritoFonte": "MedBrave_Strict_Match",
    "gabaritoCruzadoEm": "2026-10-21T02:57:50.098Z"
  },
  {
    "id": "b5b24d1a-1fe6-4002-946d-77bfb5dd463a",
