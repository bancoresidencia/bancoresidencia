  {
    "id": "0424ff3c-1a11-403f-9aee-ee5b432bd800",
    "code": "USPHCRP-2019-OBS-0066",
    "institution": "USP/HCRP - Hospital das Clínicas de Ribeirão Preto (SP)",
    "banca": "USP/HCRP",
    "year": 2019,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Intercorrências Clínicas na Gestação",
    "foco": "Hepatites B e C na Gestação: Via de Parto e Imunoprofilaxia do RN",
    "subfoco": "Hepatite B: Via de Parto e Amamentação",
