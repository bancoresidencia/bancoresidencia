  {
    "id": "aca87678-e069-4a23-b6aa-5eaea8720795",
    "code": "SEMUSASMSMAC-2015-OBS-12270",
    "institution": "SEMUSA (SMS) Macaé",
    "banca": "SEMUSA (SMS) Macaé",
    "year": 2015,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
