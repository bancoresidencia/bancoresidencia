      {
        "letter": "B",
        "text": "O teste de Clements."
      },
      {
        "letter": "C",
        "text": "A dosagem de esfingomielina."
      },
      {
        "letter": "D",
        "text": "A dosagem de fosfatidilglicerina."
      }
    ],
    "correct_answer": "A",
