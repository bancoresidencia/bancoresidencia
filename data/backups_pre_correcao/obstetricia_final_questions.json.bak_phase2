  {
    "id": "b5922bb8-795f-4495-98f9-13ba43d49006",
    "code": "SUSBA-2023-OBS-0099",
    "institution": "SUS-BA - Sistema Único de Saúde da Bahia",
    "banca": "SUS-BA",
    "year": 2023,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
