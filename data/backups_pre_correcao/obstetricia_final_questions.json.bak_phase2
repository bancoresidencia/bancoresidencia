  {
    "id": "eec72743-93a6-4c17-a7b8-818e184ce69a",
    "code": "HIAEEINSTEIN-2025-OBS-4993",
    "institution": "HIAE/Einstein - Hospital Israelita Albert Einstein (SP)",
    "banca": "HIAE/Einstein",
    "year": 2025,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
