      },
      {
        "letter": "B",
        "text": "Amniotomia e indução do parto."
      },
      {
        "letter": "C",
        "text": "Monitorar a evolução do parto."
      },
      {
        "letter": "D",
        "text": "Realizar cesárea."
      },
      {
        "letter": "E",
        "text": "Profilaxia de sepse neonatal, ocitocina e monitorar evolução do parto."
      }
    ],
    "correct_answer": "D",
    "commentary": "",
    "images": [],
    "correctAnswer": "D",
