  {
    "id": "975a79e9-44c9-4522-8dcd-5eea1661ee05",
    "code": "SUSBA-2020-OBS-8755",
    "institution": "SUS-BA - Sistema Único de Saúde da Bahia",
    "banca": "SUS-BA",
    "year": 2020,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Abortamento",
    "foco": "Tipos de Abortamento",
