  {
    "id": "707db3d4-9471-4991-bf7e-6b5f0c73e454",
    "code": "UFGDHU-2019-OBS-10870",
    "institution": "UFGD/HU - Hospital Universitário de Dourados (MS)",
    "banca": "UFGD/HU",
    "year": 2019,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Trabalho de Parto e Parto",
    "foco": "Trabalho de Parto Prematuro: Corticoterapia e Tocólise",
    "subfoco": "Tocólise: Agentes e Indicações",
    "difficulty": "Fácil",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "O uso de atosiban (tractocile) é indicado para",
    "options": [
      {
        "letter": "A",
        "text": "hipotireoidismo."
      },
      {
        "letter": "B",
        "text": "indução do parto."
      },
      {
        "letter": "C",
        "text": "bloqueio do trabalho de parto."
      },
      {
        "letter": "D",
        "text": "tratamento de sofrimento fetal."
      },
      {
        "letter": "E",
        "text": "hipertensão arterial grave."
      }
    ],
    "correct_answer": "C",
    "commentary": "Solução\nGabarito: C) bloqueio do trabalho de parto.\nGABARITO: ALTERNATIVA C\nOs principais tocolíticos são: bloqueadores do canal de cálcio (nifedipina), antagonista dos\nreceptores da ocitocina (atosiban), agonista dos receptores beta adrenérgicos (terbutalina) e\nos inibidores da síntese de prostaglandinas (indometacina).\nOs antagonistas da ocitocina (atosiban) competem com os receptores de ocitocina na célula\nmiometrial, reduzindo as contrações uterinas. Essa medicação apresenta efeitos colaterais\nleves como náuseas, cefaleia, vômitos, tontura, taquicardia e hipotensão. Tem ação efetiva em\ninibir o trabalho de parto prematuro e é o tocolítico de escolha nos países europeus e na\nFaculdade de medicina da USP, por ser efetivo e apresentar poucos efeitos colaterais, porém\ntem a desvantagem de seu custo é elevado, por isso é pouco utilizado no restante do Brasil.\nComentários:\n19. Prematuridade e Trabalho de parto prematuro (TPP)\nExtensivo - Obstetrícia \t282/291\nT.ME/MEDOPEN - ACERVO MÉDICO GRATUITO\n\nO atosiban é um antagonista da ocitocina e por isso tem ação tocolítica, sendo utilizado\nna inibição ou bloqueio do trabalho de parto prematuro.\nPortanto, está correta a alternativa “C”.",
    "images": [],
    "correctAnswer": "C",
    "is_official": true,
    "provenance": "oficial_drive_tematico",
    "official_book": "Prematuridade e Trabalho de parto prematuro (TPP).pdf.json"
  },
