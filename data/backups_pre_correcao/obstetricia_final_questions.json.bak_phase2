  {
    "id": "ead5010b-473e-4f9c-8140-88208eb8ea6e",
    "code": "UERJHUPE-2019-OBS-1636",
    "institution": "UERJ/HUPE - Hospital Universitário Pedro Ernesto (RJ)",
    "banca": "UERJ/HUPE",
