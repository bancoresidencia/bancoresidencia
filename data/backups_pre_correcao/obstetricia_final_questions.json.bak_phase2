  {
    "id": "a6d2bf80-274a-442c-87a9-4cd79e28391e",
    "code": "HMG-2023-OBS-3119",
    "institution": "HMG - Hospital Municipal Dr. Mário Gatti - Campinas (SP)",
    "banca": "HMG",
    "year": 2023,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
