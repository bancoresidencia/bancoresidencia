    "is_anulada": false,
    "statement": "A infecção aguda pela toxoplasmose, em geral, é assintomática. Dessa forma, é fundamental para o diagnóstico a avaliação sorológica para a detecção dos anticorpos imunoglobulinas (IgG e IgM), o mais precocemente possível na assistência pré-natal. Acerca disso, assinale a alternativa CORRETA.",
    "options": [
      {
        "letter": "A",
        "text": "IgG e IgM negativas indicam suscetibilidade: realizar seguinte sorológico quinzenal."
      },
      {
        "letter": "B",
        "text": "IgG positiva e IgM negativa: provável infecção recente."
      },
      {
        "letter": "C",
        "text": "IgG negativa e IgM positiva: infecção pregressa ou imunidade permanente."
      },
      {
        "letter": "D",
        "text": "IgG e IgM positivas: provável infecção aguda."
      },
      {
        "letter": "E",
        "text": "IgG e IgM negativas: dispensa seguimento sorológico."
      }
    ],
    "correct_answer": "D",
    "commentary": "",
    "images": [],
    "correctAnswer": "D",
    "isAnulada": false
  },
