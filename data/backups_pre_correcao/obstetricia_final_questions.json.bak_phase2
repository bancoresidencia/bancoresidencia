  {
    "id": "0aca5b2d-8300-4821-af58-93683debd8ab",
    "code": "UFGHC-2018-OBS-3173",
    "institution": "UFG/HC - Hospital das Clínicas da UFG - Goiânia (GO)",
    "banca": "UFG/HC",
    "year": 2018,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
