  {
    "id": "a17c9864-ee8d-42f0-b48e-9194161d4ebe",
    "code": "INEPREVALIDA-2016-OBS-13901",
    "institution": "INEP Revalida - Exame Nacional de Revalidação de Diplomas Médicos",
    "banca": "INEP Revalida",
    "year": 2016,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
