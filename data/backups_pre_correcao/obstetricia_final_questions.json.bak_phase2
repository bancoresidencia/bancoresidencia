      {
        "letter": "A",
        "text": "a decídua capsular."
      },
      {
        "letter": "B",
        "text": "a zona de junção miometrial."
      },
      {
        "letter": "C",
        "text": "o endotélio da artéria uterina."
      },
      {
        "letter": "D",
        "text": "o endotélio da decídua parietal."
      }
    ],
    "correct_answer": "B",
