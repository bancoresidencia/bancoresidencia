  {
    "id": "6fd8fb98-ef39-41a9-910b-570d783d44b4",
    "code": "UFRGSHCPA-2026-OBS-13276",
    "institution": "UFRGS/HCPA - Hospital de Clínicas de Porto Alegre (RS)",
    "banca": "UFRGS/HCPA",
    "year": 2026,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
