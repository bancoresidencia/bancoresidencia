  {
    "id": "0d3b6e3e-f151-4fec-92ce-82499ac4e9fa",
    "code": "CERMAM-2017-OBS-7742",
    "institution": "CERMAM - Comissão Estadual de Residência Médica do Amazonas",
    "banca": "CERMAM",
    "year": 2017,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Abortamento",
    "foco": "Gravidez Ectópica",
    "subfoco": "Fatores de Risco e Epidemiologia",
    "difficulty": "Fácil",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "MOP, 35 anos foi levada a maternidade pelo vizinho com fortes dores abdominais. Predominantemente em fossa ilíaca direita. Refere que há 1 ano foi internada com dor e foi tratada clinicamente com azitromicina. A última menstruação foi há 2 meses. Ao exame físico, observa-se dor abdominal difusa e equimose periumbilical. Ao toque vaginal, observa-se sangramento vaginal discreto e massa palpável à esquerda. Foi solicitado um ßHCG cujo resultado foi 3200 ui. Baseado no diagnóstico, assinale os fatores de risco da patologia da paciente.",
    "options": [
      {
        "letter": "A",
        "text": "Alimentos pequenos como caroço de mamão, uso de drogas ilícitas, o uso de levonorgestrel como anticoncepção de emergência."
      },
      {
        "letter": "B",
        "text": "Trichomonas vaginalis, uso de dispositivo intrauterino, antecedente de gravidez ectópica e o uso de duchas vaginais de repetição."
      },
      {
        "letter": "C",
        "text": "Trichomonas vaginais, uso de dispositivo intrauterino, antecedente de gravidez ectópica e o uso de estriol como anticoncepção de emergência."
      },
      {
        "letter": "D",
        "text": "Chlamydia trachomatis, uso de dispositivo intrauterino, antecedente de gravidez ectópica e o uso de levonorgestrel como anticoncepção de emergência."
      }
    ],
    "correct_answer": "D",
    "commentary": "",
