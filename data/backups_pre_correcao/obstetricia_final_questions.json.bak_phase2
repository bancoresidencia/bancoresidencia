        "text": "https://bxedpdmgvgatjdfxgxij.supabase.co/storage/v1/object/public/questoes/revalida/2025/alternativas/a-idade-gestacional-do-embriao-e-do-feto-pode-ser-verificada-alternativa-1.webp"
      },
