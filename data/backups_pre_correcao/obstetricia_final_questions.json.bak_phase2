  {
    "id": "6d18d6f3-fb2a-418d-8c89-3de512a3603b",
    "code": "UNIVERSIDADE-2021-OBS-3988",
    "institution": "Universidade do Estado do Rio Grande do Norte",
    "banca": "Universidade do Estado do Rio Grande do Norte",
    "year": 2021,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
