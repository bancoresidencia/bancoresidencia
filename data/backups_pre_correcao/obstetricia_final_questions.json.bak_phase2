    "is_anulada": false,
    "statement": "O parto vaginal pode ser realizado rotineiramente nos casos de",
    "options": [
      {
        "letter": "A",
        "text": "circular de cordão."
      },
      {
        "letter": "B",
        "text": "mãe com HIV e carga viral acima de 1.000 cópias/mL."
