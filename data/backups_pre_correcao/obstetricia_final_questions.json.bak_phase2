  {
    "id": "2bf87810-c725-4fbc-8069-f259f3994a67",
    "code": "UFGDHU-2020-OBS-11099",
    "institution": "UFGD/HU - Hospital Universitário de Dourados (MS)",
    "banca": "UFGD/HU",
    "year": 2020,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Puerpério",
    "foco": "Aleitamento Materno no Puerpério",
    "subfoco": "Amamentação em Situações Específicas",
    "difficulty": "Médio",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "A amamentação com o leite materno é importante fator que confere ao recém-nascido proteção contra patógenos entéricos, é fonte de carboidratos, gorduras e proteínas essenciais ao seu adequado desenvolvimento. A lactante produz em média 600 ml de leite por dia sob estímulo de um complexo mecanismo neuroendocrinológico. Assinale a alternativa que demonstra as oscilações corretas nesse mecanismo.",
    "options": [
      {
        "letter": "A",
        "text": "Elevação da prolactina a níveis superiores aos da gestação e consequente inibição da dopamina."
      },
      {
        "letter": "B",
        "text": "Queda dos níveis de progesterona e estrogênio, permitindo ação da prolactina na produção de α-lactalbumina."
      },
      {
        "letter": "C",
        "text": "Aumento da secreção de ocitocina de forma contínua e independente da sucção do recém-nas- cido."
      },
      {
        "letter": "D",
        "text": "Redução dos níveis de estrogênio e consequente desenvolvimento ductolobular."
      },
      {
        "letter": "E",
        "text": "Aumento dos níveis de progesterona com consequente estímulo da lactose sintase."
      }
    ],
    "correct_answer": "",
    "commentary": "",
    "images": []
