  {
    "id": "2b46d0e0-f0ee-4202-bc06-416a1621223c",
    "code": "UFRJHUCFF-2024-OBS-9244",
    "institution": "UFRJ/HUCFF - Hospital Universitário Clementino Fraga Filho (RJ)",
    "banca": "UFRJ/HUCFF",
