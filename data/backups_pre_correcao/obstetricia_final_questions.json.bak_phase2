  {
    "id": "7072d1f8-225b-4527-abdc-aa2ed4f18124",
    "code": "HMG-2017-OBS-3690",
    "institution": "HMG - Hospital Municipal Dr. Mário Gatti - Campinas (SP)",
    "banca": "HMG",
    "year": 2017,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
