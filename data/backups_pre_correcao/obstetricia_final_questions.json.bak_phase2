  {
    "id": "4dd72144-fa1b-44a3-98d4-74ec5265096d",
    "code": "UERJHUPE-2019-OBS-8550",
    "institution": "UERJ/HUPE - Hospital Universitário Pedro Ernesto (RJ)",
    "banca": "UERJ/HUPE",
