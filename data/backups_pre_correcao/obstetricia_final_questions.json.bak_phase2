    "is_anulada": false,
    "statement": "Quanto às condições inerentes ao estado gestacional, assinale a alternativa correspondente à medida ou à droga que não é recomendada para diminuição do risco de pré-eclâmpsia.",
    "options": [
      {
        "letter": "A",
        "text": "Aspirina"
      },
      {
        "letter": "B",
        "text": "Metildopa"
      },
      {
        "letter": "C",
        "text": "Suplementação de cálcio caso o consumo seja menor do que 900 mg por dia"
      },
