  {
    "id": "29ef936e-7502-41c8-bdcf-d9c567334c78",
    "code": "UFRGSHCPA-2024-OBS-9256",
    "institution": "UFRGS/HCPA - Hospital de Clínicas de Porto Alegre (RS)",
    "banca": "UFRGS/HCPA",
    "year": 2024,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Assistência Pré-natal",
    "foco": "Propedêutica do Pré-natal",
    "subfoco": "Avaliação do Crescimento Fetal",
    "difficulty": "Médio",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "Segundo orientações do Ministério da Saúde, para casos de pré-natal de risco habitual deve-se",
    "options": [
      {
        "letter": "A",
        "text": "solicitar sorologias para rubéola e citomegalovírus no primeiro trimestre, dada a alta prevalência dessas infecções no país."
      },
      {
        "letter": "B",
        "text": "iniciar suplementação polivitamínica no primeiro trimestre."
      },
      {
        "letter": "C",
        "text": "realizar exame especular e, se indicado, coletar material para exame citopatológico de colo uterino."
      },
      {
        "letter": "D",
        "text": "realizar exame cultural de material vaginal e perianal para pesquisa de Streptococcus do grupo B no segundo trimestre."
      }
    ],
    "correct_answer": "C",
    "commentary": "Gabarito Oficial [HCPA 2024 Q#31]: Correta ✅. A inspeção especular constitui procedimento obrigatório na consulta pré-natal inicial, devendo-se proceder à coleta citopatológica cervical quando a paciente não possui rastreamento atualizado (exame anterior superior a três anos ou ausência de rastreamento prévio). A condição gestacional não contraindica o exame citológico, representando oportunidade valiosa de rastreamento, considerando que frequentemente a gravidez constitui o único momento de acesso aos serviços de saúde. Ressalta-se que a partir de 2025, o Ministério da Saúde estabelece o teste de DNA-HPV como método de rastreamento para neoplasia cervical.",
    "images": [],
    "correctAnswer": "C",
    "isAnulada": false,
    "source": "questmed"
  },
