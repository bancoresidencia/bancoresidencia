    "banca": "HR Presidente Prudente",
    "year": 2022,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Trabalho de Parto e Parto",
    "foco": "Trabalho de Parto Prematuro: Corticoterapia e Tocólise",
    "subfoco": "Corticoterapia para Maturação Pulmonar Fetal",
    "difficulty": "Médio",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "Um curso de corticosteroide pode diminuir o risco da Síndrome da Angústia Respiratória do recém-nascido, melhorar a estabilidade circulatória, com menores taxas de hemorragia intraventricular, enterrocolite necrosante e infecção sistêmica nas primeiras 48 horas de vida. Com relação a esse tratamento, para acelerar a maturação pulmonar fetal, assinale a alternativa correta.",
    "options": [
      {
        "letter": "A",
        "text": "Dose de resgate é contraindicada pelo risco aumentado de RCIU (restrição de crescimento intrauterino)."
      },
      {
        "letter": "B",
        "text": "A corticoterapia pode levar à hiperglicemia transitória."
      },
      {
        "letter": "C",
        "text": "Pela sua alta atividade mineralocorticoide, causa aumento dos níveis pressóricos e, por isso, deve ser evitada nas gestantes com síndrome hipertensiva."
      },
      {
        "letter": "D",
        "text": "Nas pacientes com pré-eclampsia grave, deve ser evitada, em decorrência da urgência na necessidade da interrupção da gestação."
      },
      {
        "letter": "E",
        "text": "Se administrado com menos de 23 semanas, aumenta a sobrevivência, não causando comprometimentos graves ao feto."
      }
    ],
    "correct_answer": "B",
    "commentary": "",
    "images": [],
    "correctAnswer": "B",
    "gabaritoHomologado": true,
    "gabaritoFonte": "MedBrave_Strict_Match",
    "gabaritoCruzadoEm": "2026-10-21T02:57:50.069Z"
  },
