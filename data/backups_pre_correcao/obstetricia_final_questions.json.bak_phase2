  {
    "id": "612d5cc4-58d0-41f9-a356-6a2aea2df90f",
    "code": "UNESPHCFMB-2021-OBS-4658",
    "institution": "UNESP/HCFMB - Hospital das Clínicas de Botucatu (SP)",
    "banca": "UNESP/HCFMB",
    "year": 2021,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Assistência Pré-natal",
    "foco": "Rotina do Pré-Natal: Calendário, Suplementação e Vacinação",
    "subfoco": "Calendário Vacinal: Vacinas de Rotina na Gestação",
    "difficulty": "Médio",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "Primigesta de 21 anos, com 12 semanas de gestação, comparece assintomática na primeira consulta de pré-natal. Antes da gravidez, recebeu duas doses de vacina contendo o componente tetânico. A orientação quanto à vacina antitetânica é",
    "options": [
      {
        "letter": "A",
        "text": "informar que não há necessidade de vacinar durante a gestação."
      },
      {
        "letter": "B",
        "text": "indicar uma dose de tríplice bacteriana acelular do tipo adulto (difteria, tétano e coqueluche – dTpa) imediatamente."
      },
      {
        "letter": "C",
        "text": "indicar uma dose de dTpa a partir da 20ª semana de gestação."
      },
      {
        "letter": "D",
        "text": "indicar uma dose de dupla adulto (difteria e tétano) imediatamente e uma dose de dTpa a partir da 20a semana de gestação."
      }
    ],
    "correct_answer": "C",
    "commentary": "Gabarito Oficial [UNESP 2021 Q#24]: Correta ✅. A infecção tetânica durante o período gravídico correlaciona-se com elevados índices de morbidade e mortalidade materna e neonatal. A imunização dTpa (ou tríplice bacteriana) possui toxoides antitetânicos e antidiftéricos além do componente pertussis acelular. Deve ser administrada preferencialmente durante o segundo ou terceiro trimestre gestacional para proporcionar proteção passiva ao neonato contra coqueluche.",
    "images": [],
    "correctAnswer": "C",
    "isAnulada": false,
    "source": "questmed"
  },
