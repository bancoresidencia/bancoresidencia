  {
    "id": "33e531d3-19b9-4d24-892a-51370825729e",
    "code": "FAMERPHB-2022-OBS-7477",
    "institution": "FAMERP/HB - Faculdade de Medicina de São José do Rio Preto - Hospital de Base (SP)",
    "banca": "FAMERP/HB",
    "year": 2022,
    "tipo_prova": "Prova 1",
