    "difficulty": "Fácil",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "Assinale a alternativa que apresenta, corretamente, a anomalia fetal mais comumente observada em gestantes mais jovens.",
    "options": [
      {
        "letter": "A",
        "text": "Gastrosquise"
      },
