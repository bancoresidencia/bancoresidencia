  {
    "id": "7e28be03-26a8-48b9-bde0-c0cbd52c4f3d",
    "code": "INTO-2018-OBS-6928",
    "institution": "INTO - Instituto Nacional de Traumatologia e Ortopedia Jamil Haddad (RJ)",
    "banca": "INTO",
    "year": 2018,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Gestação Múltipla",
    "foco": "Complicações da Gemelaridade",
    "subfoco": "TRAP: Sequência de Perfusão Arterial Reversa",
    "difficulty": "Médio",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "Em gestão gemelares, observamos maior risco de diversas complicações, exceto:",
    "options": [
      {
        "letter": "A",
        "text": "Hipertensão gestacional."
      },
      {
        "letter": "B",
        "text": "Doença troflobástica gestacional."
      },
      {
        "letter": "C",
        "text": "Hiperêmese Gravídica."
      },
      {
        "letter": "D",
        "text": "Diabetes gestacional."
      },
      {
        "letter": "E",
        "text": "Pré-eclâmpsia."
      }
    ],
    "correct_answer": "B",
    "commentary": "Solução\n20. Gestação Múltipla\nExtensivo - Obstetrícia \t290/303\nT.ME/MEDOPEN - ACERVO MÉDICO GRATUITO\n\nGabarito: B) Doença troflobástica gestacional.\nGABARITO: ALTERNATIVA B\nO que o examinador quer saber: sobre as complicações nas gestações múltiplas.\nAs gestações múltiplas apresentam risco aumentado para a mãe e para o feto. Para a\ngestante há maior risco de pré-eclâmpsia, diabetes, anemia, complicações hemorrágicas,\nedema pulmonar e óbito. O principal risco para o feto é a prematuridade, mas também há\nrisco maior de restrição de crescimento, anomalias fetais e morte fetal. De forma geral, as\núnicas complicações menos frequentes nas gestações múltiplas quando comparado com as\ngestações únicas são o pós-datismo e a macrossomia fetal.\nAlém disso, as gestações monocoriônicas apresentam complicações específicas que não\nocorrem nas gestações dicoriônicas, como síndrome da transfusão feto-fetal, sequência\nanemia-policitemia, gêmeo acárdico (sequência TRAP- perfusão arterial reversa gemelar),\nenovelamento de cordão e gêmeos conjugados.\nAs complicações presentes nas gestações gemelares estão listadas na tabela abaixo:\n20. Gestação Múltipla\nExtensivo - Obstetrícia \t291/303\nT.ME/MEDOPEN - ACERVO MÉDICO GRATUITO",
    "images": [],
    "correctAnswer": "B",
    "is_official": true,
    "provenance": "oficial_drive_tematico",
    "official_book": "Gestação Múltipla.pdf.json"
  },
