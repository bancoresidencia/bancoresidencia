      {
        "letter": "B",
        "text": "Reavaliar a vitalidade após manobras de reanimação fetal."
      },
      {
        "letter": "C",
        "text": "Complementar a avaliação fetal com ultrassonografia obstétrica."
      },
      {
        "letter": "D",
        "text": "Indicar resolução imediata da gestação por parto cesárea."
      }
