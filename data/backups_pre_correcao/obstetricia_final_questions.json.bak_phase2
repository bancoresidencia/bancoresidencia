  {
    "id": "03808a6e-a674-4784-b9f5-01cdeb6d921a",
    "code": "HOSBOS-2024-OBS-7479",
    "institution": "HOS/BOS - Hospital Oftalmológico de Sorocaba - Banco de Olhos (SP)",
    "banca": "HOS/BOS",
