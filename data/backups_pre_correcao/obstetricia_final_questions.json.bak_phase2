      },
      {
        "letter": "C",
        "text": "descolamento prematuro de placenta."
      },
      {
        "letter": "D",
        "text": "pródromos de trabalho de parto."
      },
      {
        "letter": "E",
        "text": "rotura prematura de membranas."
      }
    ],
    "correct_answer": "C",
