  {
    "id": "63f648a7-ef47-463a-9f30-cbb67fe5d732",
    "code": "SEMUSASMSMAC-2021-OBS-0397",
    "institution": "SEMUSA (SMS) Macaé",
    "banca": "SEMUSA (SMS) Macaé",
    "year": 2021,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
