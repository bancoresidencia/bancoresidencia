  {
    "id": "ed97ff90-dea7-433c-a0ca-947a3476c380",
    "code": "CERMAM-2017-OBS-9687",
    "institution": "CERMAM - Comissão Estadual de Residência Médica do Amazonas",
    "banca": "CERMAM",
    "year": 2017,
    "tipo_prova": "Prova 1",
