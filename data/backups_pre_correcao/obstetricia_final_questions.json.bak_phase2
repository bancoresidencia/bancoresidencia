  {
    "id": "9d7e58ae-5306-40d6-a4fc-31a3c2239c28",
    "code": "SESGO-2023-OBS-0158",
    "institution": "SES-GO - Secretaria de Estado de Saúde de Goiás",
    "banca": "SES-GO",
