  {
    "id": "e4bce7c8-f448-4568-a16e-ef836404c1af",
    "code": "HHJICC-2025-OBS-3271",
    "institution": "HHJ-ICC - Hospital Haroldo Juaçaba / Instituto do Câncer do Ceará (CE)",
    "banca": "HHJ-ICC",
    "year": 2025,
    "tipo_prova": "Prova 1",
