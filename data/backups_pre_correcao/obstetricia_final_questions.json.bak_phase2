  {
    "id": "3aa49be5-95a7-4201-b2e1-846cbf070131",
    "code": "UNICAMPHC-2018-OBS-1982",
    "institution": "UNICAMP/HC - Hospital de Clínicas da Unicamp - Campinas (SP)",
    "banca": "UNICAMP/HC",
    "year": 2018,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Abortamento",
