  {
    "id": "16fc6aa0-1405-4254-992e-6e9a140303b9",
    "code": "SUSSP-2019-OBS-7816",
    "institution": "SUS-SP - Sistema Único de Saúde de São Paulo",
    "banca": "SUS-SP",
    "year": 2019,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Abortamento",
    "foco": "Tipos de Abortamento",
    "subfoco": "Abortamento Infectado",
    "difficulty": "Fácil",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "Gestante de 28 anos de idade, na 10ª semana, procura o pronto-socorro com queixa de sangramento vaginal moderado há 3 dias, associado a dor pélvica, febre, adinamia e anorexia. Realizou ultrassonografia há 2 semanas, compatível com o tempo gestacional, sem alterações. O exame mostra mau estado geral, temperatura de 38,5 °C, dor a palpação de abdome inferior, sem descompressão brusca. Observa-se sangramento pelo colo uterino, com saída de material necrótico, com odor desagradável. O colo uterino está pérvio para 1 cm, o útero aumentado 1 vez e doloroso à mobilização. O diagnóstico é de",
    "options": [
      {
        "letter": "A",
        "text": "neoplasia de sítio placentário."
      },
      {
        "letter": "B",
        "text": "gravidez ectópica infectada."
      },
      {
        "letter": "C",
        "text": "doença trofoblástica gestacional."
      },
      {
        "letter": "D",
        "text": "abortamento infectado."
      },
      {
        "letter": "E",
        "text": "doença inflamatória pélvica aguda."
      }
    ],
    "correct_answer": "D",
    "commentary": "",
