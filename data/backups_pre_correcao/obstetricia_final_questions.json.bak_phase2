  {
    "id": "71a905ca-203d-4bbf-9b46-e15c24c9711a",
    "code": "PSUGO-2023-OBS-1020",
    "institution": "PSU-GO - Processo Seletivo Unificado de Goiás",
    "banca": "PSU-GO",
