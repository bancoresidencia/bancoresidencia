    }
  },
  {
    "id": "2d42237c-be74-4a4b-ad29-099d65cb56f0",
    "code": "HSLSRIO-2023-OBS-9088",
    "institution": "HSL/Sírio - Hospital Sírio-Libanês (SP)",
    "banca": "HSL/Sírio",
    "year": 2023,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Trabalho de Parto e Parto",
    "foco": "Mecanismo de Parto",
    "subfoco": "Descida e Rotação Interna",
    "difficulty": "Fácil",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "Secundigesta em trabalho de parto, com 7 cm de dilatação e bolsa rota. Na palpação abdominal, o obstetra encontra o polo cefálico na escavação, apresentação fletida e conclui que se trata de ODT. Considerando a pelve como um relógio, no toque vaginal espera-se observar o lambda às",
    "options": [
      {
        "letter": "A",
        "text": "9h."
      },
      {
        "letter": "B",
        "text": "12h."
      },
      {
        "letter": "C",
        "text": "8h."
      },
      {
        "letter": "D",
        "text": "3h."
      },
      {
        "letter": "E",
        "text": "6h."
      }
    ],
    "correct_answer": "A",
    "commentary": "Solução:\nGabarito: A) 9h.\nGABARITO: ALTERNATIVA A\nVariedade de posição é a relação entre o ponto de referência da apresentação fetal e o ponto de referência da bacia óssea\nmaterna. Conhecer a variedade de posição significa saber qual é a variedade da apresentação fetal a partir da definição de\nseu ponto de referência, assim como saber para qual local da pelve materna esse ponto de referência está voltado.\nEm uma variedade occipito direita transversa (ODT) temos como ponto de referência fetal o lambda. Ele está voltado para o\nlado direito da mãe e como está transverso, significa que está no diâmetro transverso da pelve. Pensando no relógio, o lado\ndireito da mãe está à esquerda do observador. Nesse caso o lamba estará apontado para 9hs. Portanto, a alternativa\ncorreta é a letra “a”.",
    "images": [],
    "correctAnswer": "A",
    "is_official": true,
    "provenance": "oficial_drive_tematico",
    "official_book": "Bacia Obstétrica, Pelvimetria e Estática Fetal.pdf.json"
  },
  {
    "id": "b9ad8f6b-50b2-47f3-85b5-94a1430dce0b",
    "code": "SANTACASADEA-2016-OBS-9089",
    "institution": "Santa Casa de Alfenas - Casa de Caridade (MG)",
    "banca": "Santa Casa de Alfenas",
    "year": 2016,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
