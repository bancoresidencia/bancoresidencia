    "difficulty": "Médio",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "Qual é a alteração uterina, quando presente, mais associada a abortamento habitual precoce?",
    "options": [
      {
        "letter": "A",
        "text": "Útero septado"
      },
      {
        "letter": "B",
        "text": "Útero bicorno"
