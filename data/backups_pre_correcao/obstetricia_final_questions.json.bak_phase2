    "difficulty": "Médio",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "Sobre estática fetal, a variedade de posição representada na figura abaixo é:",
    "options": [
      {
        "letter": "A",
        "text": "Podálica direita anterior."
      },
      {
        "letter": "B",
        "text": "Sacro direita posterior."
      },
      {
        "letter": "C",
        "text": "Sacro esquerda anterior."
      },
      {
        "letter": "D",
