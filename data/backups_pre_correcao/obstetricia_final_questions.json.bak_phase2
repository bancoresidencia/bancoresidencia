  {
    "id": "f46edcc8-30e5-41f1-ab63-ede4e1292405",
    "code": "HSLPUCRS-2022-OBS-3802",
    "institution": "HSL PUCRS - Hospital São Lucas da PUCRS (RS)",
    "banca": "HSL PUCRS",
    "year": 2022,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Doenças Hipertensivas na Gestação",
    "foco": "Hipertensão Gestacional",
    "subfoco": "Conduta e Manejo Clínico",
    "difficulty": "Fácil",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "Primigesta, 37 anos, com idade gestacional de 36 semanas, chega ao centro obstétrico, com carta médica do posto de saúde solicitando avaliação materna e fetal devido à PA 142/92 mmHg na consulta de pré-natal. Ao exame físico no centro obstétrico, PA 146/94 mmHg, altura uterina de 35 cm, batimentos cardiofetais de 146 bpm, sem contrações uterinas e toque vaginal com BISHOP de 1. Qual é a conduta a ser realizada para essa paciente?",
    "options": [
      {
        "letter": "A",
        "text": "Mais uma aferição da pressão arterial em 60 minutos e, se normal, liberar a paciente com controle pressórico."
      },
      {
        "letter": "B",
        "text": "Rastreio para pré-eclâmpsia e, se positivo, internar a paciente, monitorar mãe e feto e planejar parto com 37 semanas."
      },
      {
        "letter": "C",
        "text": "Nova aferição da pressão arterial e, se alterada, internar a paciente e encaminhar para cesariana, devido à hipertensão gestacional."
      },
      {
        "letter": "D",
        "text": "Rastreio para pré-eclâmpsia e, se positivo, internar a paciente e encaminhar para cesariana."
      }
    ],
    "correct_answer": "B",
    "commentary": "Gabarito Oficial [PUC-RS 2022 Q#36]: Correta ✅. A abordagem correta corresponde à alternativa B: implementar investigação diagnóstica para pré-eclâmpsia e, mediante confirmação, proceder à internação hospitalar, estabelecer monitorização materno-fetal contínua e programar o parto para 37 semanas gestacionais. A investigação diagnóstica da pré-eclâmpsia deve incluir quantificação da proteinúria, determinação sérica do ácido úrico e análise da função hepática. Confirmada a suspeita diagnóstica, torna-se fundamental estabelecer vigilância rigorosa tanto materna quanto fetal para identificar precocemente sinais de agravamento clínico.",
    "images": [],
    "correctAnswer": "B",
    "isAnulada": false,
    "source": "questmed"
  },
