  {
    "id": "4971eb60-3a4b-47b9-af07-aa985b32fb59",
    "code": "UFRGSHCPA-2018-OBS-5292",
    "institution": "UFRGS/HCPA - Hospital de Clínicas de Porto Alegre (RS)",
    "banca": "UFRGS/HCPA",
    "year": 2018,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Abortamento",
    "foco": "Tipos de Abortamento",
    "subfoco": "Abortamento Inevitável",
    "difficulty": "Fácil",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "Paciente com 18 semanas de gestação veio à emergência queixando-se de dor no baixo ventre e sangramento moderado por via vaginal. Ao exame físico, encontrava-se afebril e com sinais vitais normais. Ao exame especular, apresentava sangramento em fundo de saco, sem perda de líquido amniótico. Ao toque vaginal, o colo estava 90% apagado, com 7 cm de dilatação, e a bolsa amniótica, protrusa, podendo ser palpadas partes fetais. Os batimentos cardiofetais eram de 160 bpm. O hemograma estava normal. Qual o diagnóstico mais provável e qual a conduta mais adequada?",
    "options": [
      {
        "letter": "A",
        "text": "Hematoma subcoriônico – solicitar ultrassonografia pélvica transvaginal para confirmar e estimar o tamanho do hematoma."
      },
      {
        "letter": "B",
        "text": "Trabalho de parto pré-termo – prescrever tocolítico, corticosteroide e sulfato de magnésio para neuroproteção."
      },
      {
        "letter": "C",
        "text": "Ameaça de abortamento – iniciar profilaxia para estreptococo do grupo B."
      },
      {
        "letter": "D",
        "text": "Abortamento séptico – iniciar antibioticoterapia de amplo espectro e prescrever misoprostol por via vaginal."
      },
      {
        "letter": "E",
        "text": "Abortamento inevitável – prescrever analgesia, manter NPO e aguardar a evolução do quadro."
      }
    ],
    "correct_answer": "E",
    "commentary": "",
    "images": [],
    "correctAnswer": "E",
    "isAnulada": false
  },
  {
    "id": "6bec3b95-d207-454b-a8b9-fd5a5fa5a657",
    "code": "HVCSP-2023-OBS-5293",
