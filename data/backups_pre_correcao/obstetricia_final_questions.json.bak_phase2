  {
    "id": "2830791a-5580-4220-804c-cd322c1ce7b0",
    "code": "HUGGUNIRIO-2017-OBS-3277",
    "institution": "HUGG/UNIRIO - Hospital Universitário Gaffrée e Guinle (RJ)",
    "banca": "HUGG/UNIRIO",
    "year": 2017,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Hemorragias Obstétricas",
    "foco": "Hemorragia Pós-parto",
    "subfoco": "Atonia Uterina: Manejo Clínico e Farmacológico",
    "difficulty": "Fácil",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "A hemorragia pós-parto é definida como a perda excessiva de sangue que compromete a estabilidade hemodinâmica da puérpera. Estima-se que das mortes maternas registradas no mundo seja decorrente de hemorragia puerperal. Sabendo que uma das importantes causas de hemorragia pós-parto trata-se de atonia uterina, a Organização Mundial de Saúde tem preconizado como conduta de rotina para a sua profilaxia:",
    "options": [
      {
        "letter": "A",
        "text": "Colocação de 25 mg de misoprostol, via vaginal, após o parto."
      },
      {
        "letter": "B",
        "text": "Punção de acesso venoso calibroso para infusão de cristaloides."
      },
      {
        "letter": "C",
        "text": "Aplicação de 10 UI de ocitocina, intramuscular, após a expulsão fetal."
      },
      {
        "letter": "D",
        "text": "Massagem do fundo uterino durante 1-3 minutos após a dequitação."
      },
      {
        "letter": "E",
        "text": "Curagem uterina para remover qualquer tecido placentário retido."
      }
    ],
    "correct_answer": "C",
    "commentary": "Solução\nGabarito: A) Aplicação de 10 UI de ocitocina, intramuscular, após a expulsão fetal.\nO que o examinador quer saber: sobre a profilaxia para hemorragia pós-parto.\nA profilaxia de hemorragia pós-parto tem como principal medida o uso universal da ocitocina\napós o nascimento, na dose de 10UI intramuscular. Quando a gestante apresenta fatores de\nrisco para HPP, pode-se administrar ácido tranexâmico juntamente com a ocitocina para\nprevenção.\nAdemais, outras medidas de prevenção para HPP também devem ser realizadas, as quais\nestão listadas na tabela abaixo:\nGABARITO: ALTERNATIVA A",
    "images": [],
    "correctAnswer": "C",
    "is_official": true,
    "provenance": "oficial_drive_tematico",
    "official_book": "Hemorragia Pós-Parto (HPP).pdf.json"
  },
