  {
    "id": "fde40fa7-feeb-4984-a137-86ac691037e8",
    "code": "HOSBOS-2023-OBS-8295",
    "institution": "HOS/BOS - Hospital Oftalmológico de Sorocaba - Banco de Olhos (SP)",
    "banca": "HOS/BOS",
    "year": 2023,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
