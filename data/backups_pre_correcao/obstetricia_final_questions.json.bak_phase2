    "code": "USPHCFMUSP-2018-OBS-9688",
    "institution": "USP/HCFMUSP - Hospital das Clínicas da FMUSP (SP)",
    "banca": "USP/HCFMUSP",
    "year": 2018,
    "tipo_prova": "Prova 1",
