  {
    "id": "292e42a3-73d8-42da-86ff-3a925c417c75",
    "code": "CERMAM-2020-OBS-9076",
    "institution": "CERMAM - Comissão Estadual de Residência Médica do Amazonas",
    "banca": "CERMAM",
    "year": 2020,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Assistência Pré-natal",
    "foco": "Diagnóstico e Datação da Gestação",
    "subfoco": "Cálculo da Idade Gestacional pela Data da Última Menstruação (DUM)",
    "difficulty": "Fácil",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "Gestante no interior do Amazonas foi à primeira consulta do pré-natal. Não sabia a data da última menstruação nem tinha nenhum exame. Sabendo que se trata de uma gestação única e fisiológica, e que ao exame físico, o fundo de útero estava ao nível da cicatriz umbilical, qual idade gestacional essa gestante deve estar?",
    "options": [
      {
        "letter": "A",
        "text": "20 semanas"
      },
      {
        "letter": "B",
        "text": "24 semanas"
      },
      {
        "letter": "C",
        "text": "16 semanas"
      },
      {
        "letter": "D",
        "text": "18 semanas"
      }
    ],
    "correct_answer": "A",
    "commentary": "Gabarito Oficial [CERMAM 2020 Q#42]: Correta ✅. A determinação da idade gestacional fundamenta-se em diversos critérios, incluindo o registro da última menstruação, avaliação ultrassonográfica e palpação uterina durante o exame físico. Na situação clínica apresentada, considerando a ausência de informações sobre o último período menstrual e a inexistência de documentação ultrassonográfica prévia, o achado de fundo uterino posicionado na altura da cicatriz umbilical corresponde aproximadamente a 20 semanas de gestação.",
    "images": [],
    "correctAnswer": "A",
    "isAnulada": false,
    "source": "questmed"
  },
