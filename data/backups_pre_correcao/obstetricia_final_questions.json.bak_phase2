  {
    "id": "42df1b84-6e74-4964-bcb2-4470f6c9bf9b",
    "code": "UFALHUPAA-2018-OBS-4728",
    "institution": "UFAL/HUPAA - Hospital Universitário Prof. Alberto Antunes (AL)",
    "banca": "UFAL/HUPAA",
    "year": 2018,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
