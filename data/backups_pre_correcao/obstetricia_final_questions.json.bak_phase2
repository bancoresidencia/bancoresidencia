  {
    "id": "b189e359-a4e8-4971-8f96-2c820725b3af",
    "code": "UNESPHCFMB-2022-OBS-1911",
    "institution": "UNESP/HCFMB - Hospital das Clínicas de Botucatu (SP)",
    "banca": "UNESP/HCFMB",
