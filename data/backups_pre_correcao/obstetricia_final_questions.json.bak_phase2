  },
  {
    "id": "19ad62c4-9a31-4349-bd83-70a37997714d",
    "code": "PSUMG-2020-OBS-4235",
    "institution": "PSU-MG - Processo Seletivo Unificado de Minas Gerais",
    "banca": "PSU-MG",
    "year": 2020,
    "tipo_prova": "Prova 1",
