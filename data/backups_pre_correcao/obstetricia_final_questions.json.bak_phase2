  {
    "id": "17a4516f-2c73-4124-93e5-be9d3501ab44",
    "code": "HFCF-2019-OBS-7936",
    "institution": "HFCF - Hospital Federal Cardoso Fontes (RJ)",
    "banca": "HFCF",
    "year": 2019,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
