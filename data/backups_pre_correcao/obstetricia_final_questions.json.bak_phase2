    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "A ocorrência de DIP I (precoce) observada na cardiotocografia intraparto indica",
    "options": [
      {
        "letter": "A",
        "text": "esposta fisiológica à hiperventilação materna durante a contração uterina."
