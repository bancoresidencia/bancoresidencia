  {
    "id": "6517295e-983d-4154-a621-36c42956d9fb",
    "code": "HSAGUARUJ-2023-OBS-2728",
    "institution": "HSA Guarujá - Hospital Santo Amaro de Guarujá (SP)",
    "banca": "HSA Guarujá",
