  {
    "id": "24e93766-2384-4e24-a0f1-4d536a429b81",
    "code": "UFMAHUUFMA-2017-OBS-3983",
    "institution": "UFMA/HU-UFMA - Hospital Universitário da UFMA (MA)",
    "banca": "UFMA/HU-UFMA",
