  {
    "id": "138b3c13-d819-4ae7-9f5d-a369bb413258",
    "code": "SMSSP-2016-OBS-7672",
    "institution": "SMS-SP - Secretaria Municipal de Saúde de São Paulo",
    "banca": "SMS-SP",
    "year": 2016,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Trabalho de Parto e Parto",
    "foco": "Amniorrexe Prematura: Corioamnionite e Profilaxias",
    "subfoco": "Definição e Epidemiologia da RPM",
    "difficulty": "Médio",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "A Ruptura Prematura de Membranas (RPM) está associada a grande percentual de partos prematuros, complicações infecciosas materno-fetais e sequelas fetais. Espontaneamente ocorre em, aproximadamente, 3 a 5% das gestações e 30% dos partos prematuros, aumentando sua prevalência inversamente à idade gestacional do parto. Neste contexto, assinale a alternativa correta.",
    "options": [
      {
        "letter": "A",
        "text": "É considerável a associação entre relação sexual, exame especular, exercício materno e paridade com a RPM pré-termo."
      },
      {
        "letter": "B",
        "text": "A maioria dos casos de RPM pré-termo ocorre em mulheres saudáveis e aparentemente sem fatores de risco identificáveis."
      },
      {
        "letter": "C",
        "text": "O tempo de latência é definido como o intervalo entre a ruptura das membranas ovulares e o início do trabalho de parto, considerado prolongado quando maior que 48 horas."
      },
      {
        "letter": "D",
        "text": "Pode-se dividir as causas em espontâneas e iatrogênicas, sendo a causa iatrogênica a mais comum. A RPM ocorre iatrogenicamente em 1:100 amniocenteses e 3 a 5% após fetoscopia."
      }
    ],
    "correct_answer": "B",
    "commentary": "",
    "images": [],
    "correctAnswer": "B",
    "isAnulada": false
  },
  {
    "id": "751239b7-925e-4461-ae53-fbc0e5f499f2",
