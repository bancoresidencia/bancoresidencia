      "banca": "COREME/FMUSP (Tekyou Soluções)",
      "edital": "Processo Seletivo Residência Médica FMUSP 2022 (Acesso Direto e Áreas Básicas)",
      "exam_date": "27/11/2021",
      "prova_source": "FMUSP22-Acesso_Direto-prova.pdf",
