  {
    "id": "afda9606-1904-4a93-863a-39a951a68e33",
    "code": "SMSSOJOSDORI-2024-OBS-5647",
    "institution": "SMS São José do Rio Preto - Secretaria Municipal de Saúde (SP)",
    "banca": "SMS São José do Rio Preto",
    "year": 2024,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
