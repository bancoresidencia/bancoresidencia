  {
    "id": "1ef3a3bb-a283-4d6b-a169-cbaa937c12c5",
    "code": "IFFFIOCRUZ-2021-OBS-8004",
    "institution": "IFF/Fiocruz - Instituto Fernandes Figueira (RJ)",
