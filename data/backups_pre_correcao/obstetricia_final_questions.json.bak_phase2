      },
      {
        "letter": "B",
        "text": "Expectante, pois os testes apontam infecção crônica."
      },
      {
        "letter": "C",
        "text": "Indicar tratamento com sulfadiazina, pirimetamina e ácido folínico."
      },
      {
        "letter": "D",
        "text": "Indicar amniocentese e tratar caso haja comprometimento fetal."
      }
    ],
    "correct_answer": "",
    "commentary": "",
    "images": []
