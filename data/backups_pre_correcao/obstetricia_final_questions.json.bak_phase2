  {
    "id": "2cbb893d-4321-4aec-87ed-4c0bccd1ad70",
    "code": "SANTACASADES-2021-OBS-5289",
    "institution": "Santa Casa de São Paulo - ISCMSP/FCMSCSP (SP)",
