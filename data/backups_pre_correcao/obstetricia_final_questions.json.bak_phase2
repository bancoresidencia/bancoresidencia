        "letter": "A",
        "text": "Repetir cardiotocografia após manobras de reanimação fetal."
      },
      {
        "letter": "B",
        "text": "Realizar resolução da gestação por cesárea."
      },
      {
        "letter": "C",
        "text": "Repetir o perfil biofísico fetal após alimentação materna."
      },
      {
        "letter": "D",
        "text": "Iniciar indução do trabalho de parto."
      }
