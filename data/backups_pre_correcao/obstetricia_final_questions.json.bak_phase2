  {
    "id": "0a66f066-632b-4b3c-8c5f-a183756f826e",
    "code": "UFSCHU-2022-OBS-1492",
    "institution": "UFSC/HU - Hospital Universitário Prof. Polydoro Ernani de São Thiago (SC)",
    "banca": "UFSC/HU",
    "year": 2022,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
