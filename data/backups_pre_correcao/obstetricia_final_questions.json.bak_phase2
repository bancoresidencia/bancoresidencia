  {
    "id": "4ef88ee6-3398-483c-824d-3a7f6add86ca",
    "code": "HMDI-2019-OBS-9371",
    "institution": "HMDI - Hospital e Maternidade Dona Iris (GO)",
    "banca": "HMDI",
    "year": 2019,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Puerpério",
    "foco": "Aleitamento Materno no Puerpério",
    "subfoco": "Ordenha e Armazenamento do Leite Materno",
    "difficulty": "Fácil",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "Valéria, 22 anos, puérpera, vem à consulta de revisão após o parto, acompanhada pelo companheiro João, pai da criança. Pedro, nascido há 01 semana, com 3.600 g, hígido, parto vaginal sem intercorrências, no momento recebendo apenas leite materno. Mãe relata intenção de complementar aleitamento com mamadeira à noite, pois tem \"receio que o bebê chore\". No momento, apresenta mamilo irritado, com rachaduras e dor ao toque. Relata não ter conseguido amamentar seu primeiro filho por muito tempo, pois a criança chorava muito, o que a deixava ansiosa, pois imaginava que o bebê estivesse com fome e, embora a criança ganhasse peso adequadamente, iniciou fórmula infantil aos 2 meses de idade. Relata que a quantidade de leite materno foi diminuindo e aos 03 meses deixou de amamentar, o que a entristeceu, pois gostaria de ter amamentado por mais tempo seu primeiro filho. Refere ter conhecimento de que o aleitamento materno protege contra muitas doenças, porém, observa que seu primogênito é extremamente alérgico, mas não costuma ter infecções. João mostra-se ansioso em relação à saúde dos filhos e relata fazer o que for preciso para que seu filho não tenha problemas de alergia como o primeiro. Em relação ao aleitamento materno, responda a alternativa correta: Considera-se como informação mais relevante para concluir que a fórmula infantil foi utilizada, desnecessariamente, pelo primeiro filho de Valéria:",
    "options": [
      {
        "letter": "A",
        "text": "O fato de a criança ter apenas dois meses."
      },
      {
        "letter": "B",
        "text": "A forte intenção de Valéria de amamentar."
      },
      {
        "letter": "C",
        "text": "O fato de a criança ser alérgica."
      },
      {
        "letter": "D",
        "text": "A informação de que a criança ganhou peso adequadamente."
      }
    ],
    "correct_answer": "D",
    "commentary": "",
    "images": [],
    "correctAnswer": "D",
    "isAnulada": false
  },
