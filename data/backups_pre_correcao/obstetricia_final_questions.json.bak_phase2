  {
    "id": "cd1023e0-9d6c-40c8-a6c2-28f836aa8852",
    "code": "PSUMG-2025-OBS-5268",
    "institution": "PSU-MG - Processo Seletivo Unificado de Minas Gerais",
    "banca": "PSU-MG",
    "year": 2025,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
