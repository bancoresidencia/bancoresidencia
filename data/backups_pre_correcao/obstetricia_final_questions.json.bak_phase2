  {
    "id": "9322746e-c0ec-4cbb-8c07-62d7b567f79f",
    "code": "UNICAMPHC-2022-OBS-7535",
    "institution": "UNICAMP/HC - Hospital de Clínicas da Unicamp - Campinas (SP)",
