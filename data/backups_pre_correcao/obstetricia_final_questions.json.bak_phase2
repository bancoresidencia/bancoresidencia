  {
    "id": "7b7f69ef-1176-4773-bb12-648f40f9daa8",
    "code": "UFRGSHCPA-2022-OBS-4011",
    "institution": "UFRGS/HCPA - Hospital de Clínicas de Porto Alegre (RS)",
    "banca": "UFRGS/HCPA",
    "year": 2022,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Intercorrências Clínicas na Gestação",
    "foco": "Sífilis na Gestação: Diagnóstico e Tratamento",
    "subfoco": "Tratamento da Sífilis na Gestação",
    "difficulty": "Médio",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "Paciente de 27 anos, G3P2 (último parto há 3 anos e todas as gestações do mesmo companheiro), com 30 semanas de gestação, portadora de lúpus eritematoso sistêmico, assintomática, trouxe à consulta os resultados dos seguintes exames: VDRL 1:8 e FTA-Abs reagente. O exame físico não revelou alterações. Não tinha história de tratamento para sífilis. Qual a conduta correta?",
    "options": [
      {
        "letter": "A",
        "text": "Prescrever penicilina G benzatina 2,4 milhões de unidades intramuscular para a gestante."
      },
      {
        "letter": "B",
        "text": "Prescrever penicilina G benzatina 7,2 milhões de unidades intramuscular para o casal."
      },
      {
        "letter": "C",
