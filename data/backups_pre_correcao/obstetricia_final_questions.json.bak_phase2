  {
    "id": "86750e07-9072-4bbb-a61b-483d5cfdcf25",
    "code": "SANTACASADEC-2024-OBS-5918",
    "institution": "Santa Casa de Campo Grande (MS)",
    "banca": "Santa Casa de Campo Grande (MS)",
    "year": 2024,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Doenças Hipertensivas na Gestação",
    "foco": "Pré-eclâmpsia e Eclâmpsia",
    "subfoco": "Pré-eclâmpsia com Sinais de Gravidade",
    "difficulty": "Difícil",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "Paciente de 23 anos dá entrada em maternidade com quadro de crise hipertensiva (PA 170X120 mmHg), com diagnóstico de pré-eclampsia grave com proteinúria importante. Para tratamento da crise hipertensiva com hidralazina endovenosa a dose deve ser:",
    "options": [
      {
        "letter": "A",
        "text": "10 mg a cada 20 minutos, dose máxima 30 mg."
      },
      {
        "letter": "B",
        "text": "5 mg a cada 40 minutos, dose máxima 40 mg."
      },
      {
        "letter": "C",
        "text": "10 mg a cada 30 minutos, dose máxima de 30 mg."
      },
      {
        "letter": "D",
        "text": "5 mg a cada 20 minutos, dose máxima 30 mg."
      }
    ],
    "correct_answer": "D",
    "commentary": "Solução\nGabarito: D) 5 mg a cada 20 minutos, dose máxima 30 mg.\nO que o examinador quer saber: sobre o tratamento da crise hipertensiva na gestação.\nQuando a gestante apresenta níveis pressóricos ≥ 160 x 110 mmHg confirmados após 15 min\nde repouso, considera-se que ela tem hipertensão arterial grave ou crise hipertensiva.\nO controle da hipertensão arterial grave é importante para prevenir falência cardíaca, infarto\nagudo do miocárdio e acidente vascular cerebral isquêmico ou hemorrágico. O objetivo é\nmanter a PA entre 140-150/90-100 mmHg; para isso, utilizam-se anti-hipertensivos mais\npotentes do que aqueles utilizados para controle de hipertensão arterial leve.\nAs medicações de escolha para o controle da hipertensão arterial grave na gestação são\nhidralazina endovenosa e nifedipina oral. No Brasil, a hidralazina é, ainda, a medicação mais\nutilizada nos casos de crise hipertensiva na gestação. O labetalol é uma alternativa eficaz na\ngestação, mas não está disponível no Brasil.\nCaso a hipertensão arterial grave seja refratária a essas medicações, utiliza-se o nitroprussiato\nde sódio endovenoso em bomba de infusão. Devem-se evitar quedas bruscas de pressão\narterial, pelo risco de diminuição do fluxo sanguíneo nos territórios cardíaco, cerebral e\nplacentário. O nitroprussiato de sódio é medicação de escolha diante de pré-eclâmpsia grave\ncom edema agudo de pulmão. As medicações utilizadas para o tratamento de crise\nhipertensiva estão listadas da tabela a seguir:\n11. Síndromes Hipertensivas da Gestação\nExtensivo - Obstetrícia \t313/418\nT.ME/MEDOPEN - ACERVO MÉDICO GRATUITO",
    "images": [],
    "correctAnswer": "D",
    "is_official": true,
    "provenance": "oficial_drive_tematico",
    "official_book": "Síndromes Hipertensivas da Gestação.pdf.json"
  },
