  {
    "id": "fc7dd2a8-82ae-46a5-a7d1-70ac513b6dca",
    "code": "HMSOJOS-2022-OBS-3832",
    "institution": "HM São José - Hospital Municipal de São José (SC)",
    "banca": "HM São José",
    "year": 2022,
