  {
    "id": "328c5016-2a25-4c50-b9c5-b9b760ab626e",
    "code": "UNIVERSIDADE-2020-OBS-4630",
    "institution": "Universidade Estadual do Piauí - Campus Teresina",
    "banca": "Universidade Estadual do Piauí",
    "year": 2020,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Intercorrências Clínicas na Gestação",
    "foco": "Diabetes Gestacional",
    "subfoco": "Rastreamento e Diagnóstico do Diabetes Gestacional (TOTG)",
    "difficulty": "Médio",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "Considerando-se a relevância do Diabetes Mellitus Gestacional (DMG), tanto por sua prevalência como pelas consequências para o binômio materno-fetal, marque a opção CORRETA.",
    "options": [
      {
        "letter": "A",
        "text": "Recomenda-se o rastreamento universal apenas para as pacientes com fator de risco associado, otimizando exames com maior sensibilidade como a hemoglobina glicada."
      },
      {
        "letter": "B",
        "text": "Efeitos fetais relevantes, como as malformações cardíacas, são mais marcantes, quando o descontrole glicêmico acomete o 2º e 3º trimestre."
      },
      {
        "letter": "C",
        "text": "O diabetes mellitus gestacional se caracteriza pela intolerância à glicose exclusiva, na segunda metade da gravidez."
      },
      {
        "letter": "D",
        "text": "Malformacões cardíacas fetais, macrossomia, polidramnia são diretamente decorrentes das hipoglicemias da terapêutica farmacológica."
      },
      {
        "letter": "E",
