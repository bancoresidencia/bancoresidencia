  {
    "id": "ce49e339-d085-490c-a79f-97af851e2d16",
    "code": "UFSCAR-2020-OBS-0108",
    "institution": "UFSCar - Hospital Universitário de São Carlos (SP)",
    "banca": "UFSCar",
    "year": 2020,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
