  {
    "id": "99f851e2-cc56-45ff-b62c-c2d9b3c99c21",
    "code": "SANTACASADEA-2017-OBS-0621",
    "institution": "Santa Casa de Alfenas - Casa de Caridade (MG)",
    "banca": "Santa Casa de Alfenas",
    "year": 2017,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Hemorragias Obstétricas",
    "foco": "Descolamento Prematuro de Placenta",
    "subfoco": "Via de Parto: Vaginal se Estável, Cesárea se Grave",
    "difficulty": "Médio",
