    "statement": "A finalidade básica do teste de Clements é:",
    "options": [
      {
        "letter": "A",
        "text": "Diagnosticar rotura prematura de membranas."
      },
      {
        "letter": "B",
        "text": "Atestar a maturidade pulmonar fetal."
