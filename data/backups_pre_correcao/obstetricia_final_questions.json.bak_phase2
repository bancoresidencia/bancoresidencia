  {
    "id": "b2a11f54-fcdb-4421-a776-b7673c33106f",
    "code": "UNICAMPHC-2010-OBS-13170",
    "institution": "UNICAMP/HC - Hospital de Clínicas da Unicamp - Campinas (SP)",
    "banca": "UNICAMP/HC",
    "year": 2010,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Intercorrências Clínicas na Gestação",
    "foco": "HIV na Gestação e Profilaxias",
    "subfoco": "Profilaxia Antirretroviral Neonatal (RN)",
    "difficulty": "Médio",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "Menino, 6 semanas de vida, vem para consulta de rotina. Alimenta-se com fórmula infantil de partida. Cartão de imunização registrta BOG ao nascer e uma dose de hepatite B. Desde o nascimento toma Zidovudine (AZT) VO. Antecedentes: nasceu de mãe que foi surpreendida pelo diagnóstico de AIDS no momento do parto. Parto via vaginal, a termo, peso= 2800 g, comprimento= 48 cm, Apgar= 8/9. Exame físico: peso= 4000 g, comprimento= 52 cm, palidez cutânea e mucosa, presença de exsudato cremoso, esbranquiçado, facilmente removível em mucosa oral. A CONDUTA É:",
    "options": [
      {
        "letter": "A",
        "text": "Manter AZT, iniciar sulfametoxazol-trimetoprim e nistatina VO, aplicar 2º dose da vacina contra hepatite B e 1º dose de SALK."
      },
      {
        "letter": "B",
        "text": "Solicitar hemograma e transaminases hepáticas, suspender AZT, iniciar sulfametoxazoltrimetoprim e nistatina VO."
      },
      {
        "letter": "C",
        "text": "Manter AZT, iniciar sulfametoxazol-trimetoprim e nistatina VO, aplicar 2º dose da vacina contra hepatite B."
      },
      {
        "letter": "D",
        "text": "Solicitar hamograma, suspender AZT, iniciar sulfametoxazol-trimetoprim e nistatina VO, aplicar 2º dose da vacina contra hepatite B."
      }
    ],
    "correct_answer": "D",
    "commentary": "",
    "images": [],
    "correctAnswer": "D",
    "isAnulada": false
  },
  {
    "id": "d9829ca6-45f4-4e54-9f55-96f82e83a434",
    "code": "UNICAMPHC-2010-OBS-13171",
    "institution": "UNICAMP/HC - Hospital de Clínicas da Unicamp - Campinas (SP)",
