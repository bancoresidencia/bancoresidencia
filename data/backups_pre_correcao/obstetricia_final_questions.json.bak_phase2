  {
    "id": "ce594ed8-b91a-4d62-95ad-c5466512a480",
    "code": "UFRGSHCPA-2025-OBS-9573",
    "institution": "UFRGS/HCPA - Hospital de Clínicas de Porto Alegre (RS)",
    "banca": "UFRGS/HCPA",
    "year": 2025,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Assistência Pré-natal",
