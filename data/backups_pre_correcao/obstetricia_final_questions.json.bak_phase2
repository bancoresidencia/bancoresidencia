  {
    "id": "df70b551-986d-456e-a0ff-1e8def97cb30",
    "code": "HMG-2021-OBS-12311",
    "institution": "HMG - Hospital Municipal Dr. Mário Gatti - Campinas (SP)",
    "banca": "HMG",
    "year": 2021,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
