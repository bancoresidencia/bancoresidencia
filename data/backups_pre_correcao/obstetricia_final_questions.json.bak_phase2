  {
    "id": "2c5da560-680a-4023-81de-4128c8826d01",
    "code": "SMSSP-2017-OBS-5071",
    "institution": "SMS-SP - Secretaria Municipal de Saúde de São Paulo",
    "banca": "SMS-SP",
