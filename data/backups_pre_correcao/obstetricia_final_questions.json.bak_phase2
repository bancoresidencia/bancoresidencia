  {
    "id": "642a28b2-f4e5-49dd-8c86-08ef26face28",
    "code": "SESRJ-2021-OBS-12378",
    "institution": "SES-RJ - Secretaria de Estado de Saúde do Rio de Janeiro",
    "banca": "SES-RJ",
    "year": 2021,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Intercorrências Clínicas na Gestação",
    "foco": "Diabetes Gestacional",
    "subfoco": "Rastreamento e Diagnóstico do Diabetes Gestacional (TOTG)",
    "difficulty": "Fácil",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "A obesidade é um problema de saúde pública mundial, associado a diversas complicações na gestação, além de efeitos em longo prazo para a paciente e seu feto. Entre as complicações que apresentam maior risco para a paciente obesa, encontra-se, EXCETO:",
    "options": [
      {
        "letter": "A",
        "text": "abortamento de repetição"
      },
      {
        "letter": "B",
        "text": "hemorragia pós-parto"
      },
      {
        "letter": "C",
        "text": "macrossomia fetal"
      },
      {
        "letter": "D",
        "text": "gestação gemelar"
      }
    ],
    "correct_answer": "D",
    "commentary": "Gabarito Oficial [SES-RJ 2021 Q#30]: Correta ✅. A obesidade materna não estabelece relação causal direta com o aumento da probabilidade de gestações múltiplas. A ocorrência de gemelaridade associa-se predominantemente a fatores como utilização de métodos de reprodução medicamente assistida, idade materna em faixas etárias mais elevadas e antecedentes pessoais de gestações gemelares. Consequentemente, esta representa a alternativa que não constitui complicação caracteristicamente vinculada ao estado de obesidade.",
    "images": [],
    "correctAnswer": "D",
    "isAnulada": false,
    "source": "questmed"
  },
