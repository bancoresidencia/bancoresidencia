  {
    "id": "54ee1d9e-1f06-4bef-8ed8-25a18792c8e3",
    "code": "HFA-2020-OBS-6679",
    "institution": "HFA - Hospital das Forças Armadas (DF)",
    "banca": "HFA",
    "year": 2020,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Doenças Hipertensivas na Gestação",
