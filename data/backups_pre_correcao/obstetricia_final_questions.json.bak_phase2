  {
    "id": "a717995e-266c-4766-ab09-aaf6502c3e19",
    "code": "HUGGUNIRIO-2021-OBS-12407",
    "institution": "HUGG/UNIRIO - Hospital Universitário Gaffrée e Guinle (RJ)",
