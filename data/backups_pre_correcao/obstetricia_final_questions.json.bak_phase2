      {
        "letter": "B",
        "text": "Indução de parto com ocitocina, pois é uma amniorrexe prematura de termo."
      },
      {
        "letter": "C",
        "text": "Realização de cesárea após antibioticoprofilaxia para estreptococo do grupo B."
      },
      {
        "letter": "D",
        "text": "Cesárea imediata sem necessidade de antibioticoprofilaxia."
      }
    ],
