    "tema": "Trabalho de Parto e Parto",
    "foco": "Estática Fetal",
    "subfoco": "Apresentação Pélvica e Transversa",
    "difficulty": "Médio",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "A linha de orientação da cefálica defletida de primeiro grau é denominada",
    "options": [
