  {
    "id": "c6cdd358-ad8e-43ff-9443-fb62d536d6d1",
    "code": "USPHCRP-2024-OBS-2046",
    "institution": "USP/HCRP - Hospital das Clínicas de Ribeirão Preto (SP)",
    "banca": "USP/HCRP",
    "year": 2024,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
