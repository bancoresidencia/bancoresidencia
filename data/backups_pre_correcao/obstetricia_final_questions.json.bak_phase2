  {
    "id": "21b2a57b-2041-49af-9176-95058988f55b",
    "code": "UERJHUPE-2023-OBS-6524",
    "institution": "UERJ/HUPE - Hospital Universitário Pedro Ernesto (RJ)",
    "banca": "UERJ/HUPE",
    "year": 2023,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
