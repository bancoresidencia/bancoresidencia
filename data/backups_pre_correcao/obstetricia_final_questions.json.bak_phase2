        "letter": "C",
        "text": "Abortamento provocado complicado."
      },
      {
        "letter": "D",
        "text": "Gravidez ectópica."
      },
      {
        "letter": "E",
        "text": "Doença trofoblástica gestacional benigna."
      }
    ],
