  {
    "id": "833fcf28-c863-49bc-b1dc-c2271314ee49",
    "code": "SANTACASADEA-2017-OBS-2895",
    "institution": "Santa Casa de Araçatuba (SP)",
    "banca": "Santa Casa de Araçatuba (SP)",
    "year": 2017,
    "tipo_prova": "Prova 1",
