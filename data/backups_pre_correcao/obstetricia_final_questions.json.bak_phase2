  {
    "id": "386fa944-7735-4fbf-bb4a-977205b24257",
    "code": "UNIVERSIDADE-2021-OBS-10186",
    "institution": "Universidade Federal do Rio Grande do Norte - Escola Multicampi de Ciências Médicas",
    "banca": "Universidade Federal do Rio Grande do Norte",
    "year": 2021,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Trabalho de Parto e Parto",
