        "letter": "A",
        "text": "iniciar misoprostol"
      },
      {
        "letter": "B",
        "text": "indicar cerclagem uterina"
      },
      {
        "letter": "C",
        "text": "indicar repouso e analgésicos"
      },
      {
        "letter": "D",
        "text": "prescrever de progesterona vaginal"
      }
