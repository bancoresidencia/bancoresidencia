    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Intercorrências Clínicas na Gestação",
    "foco": "HIV na Gestação e Profilaxias",
    "subfoco": "Via de Parto em Gestante HIV Positivo",
    "difficulty": "Médio",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "Assinale a alternativa correta, sobre gestante primigesta, no termo, portadora de vírus da imunodeficiência humana (HIV).",
    "options": [
      {
        "letter": "A",
        "text": "A cesárea eletiva está indicada com carga viral ≥ 10 000 cópias/mL e deve ser realizada entre 37 e 38 semanas de gestação."
      },
      {
        "letter": "B",
        "text": "Com carga viral ≥ 1 000 cópias/mL, em trabalho de parto com membranas ovulares íntegras e cervicodilatação menor que 4 cm – realizar cesárea."
      },
      {
        "letter": "C",
        "text": "A cesárea eletiva depende dos valores de CD4 e deve ser realizada entre 39 e 40 semanas de gestação."
      },
      {
        "letter": "D",
        "text": "A via de parto é de indicação obstétrica em gestantes com carga viral < 10 000 cópias/mL."
      },
      {
        "letter": "E",
        "text": "Inibir o trabalho de parto em parturientes com carga viral ≥ 1 000 cópias/mL com cervicodilatação maior ou igual a 4 cm e/ou membranas ovulares rotas."
      }
    ],
    "correct_answer": "B",
    "commentary": "Gabarito Oficial [SUS-SP 2021 Q#59]: Correta ✅. Quando a quantificação viral apresenta-se indeterminada ou igual/superior a 1.000 cópias/mL, preconiza-se cesariana eletiva às 38 semanas gestacionais. Entretanto, na ocorrência de trabalho de parto espontâneo prematuro, desde que a parturiente apresente dilatação cervical limitada (máximo 4cm), deve-se instituir zidovudina endovenosa e proceder à cesariana após período de 3 horas (quando viável).",
    "images": [],
    "correctAnswer": "B",
    "isAnulada": false,
    "source": "questmed"
  },
