  {
    "id": "469c1d38-fb1a-46e0-8fc7-69b5ad83241d",
    "code": "HFA-2021-OBS-6035",
    "institution": "HFA - Hospital das Forças Armadas (DF)",
    "banca": "HFA",
    "year": 2021,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
