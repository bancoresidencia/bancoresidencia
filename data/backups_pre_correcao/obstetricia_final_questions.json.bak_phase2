  {
    "id": "cdf83a14-c760-45be-bbb5-2f1bff70eb2e",
    "code": "UERJHUPE-2017-OBS-5622",
    "institution": "UERJ/HUPE - Hospital Universitário Pedro Ernesto (RJ)",
    "banca": "UERJ/HUPE",
    "year": 2017,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
