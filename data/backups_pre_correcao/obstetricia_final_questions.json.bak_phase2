  {
    "id": "f637f6c5-2780-4b43-88d7-6a17a9881c11",
    "code": "SESRJ-2020-OBS-6713",
    "institution": "SES-RJ - Secretaria de Estado de Saúde do Rio de Janeiro",
    "banca": "SES-RJ",
    "year": 2020,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Doenças Hipertensivas na Gestação",
    "foco": "Pré-eclâmpsia e Eclâmpsia",
    "subfoco": "Eclâmpsia: Crise Convulsiva e Manejo",
    "difficulty": "Fácil",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "A pré-eclâmpsia continua sendo uma das principais causas de morte materna e perinatal no país, sendo de grande importância o seu adequado diagnóstico e tratamento. A droga de escolha, no tratamento do episódio convulsivo (eclâmpsia), deve ser:",
    "options": [
      {
        "letter": "A",
        "text": "sulfato de magnésio"
      },
      {
        "letter": "B",
        "text": "hidralazina"
      },
      {
        "letter": "C",
        "text": "Diazepam"
      },
      {
        "letter": "D",
        "text": "fenitoína"
      }
    ],
    "correct_answer": "A",
    "commentary": "Gabarito Oficial [SES-RJ 2020 Q#78]: Correta ✅. O sulfato de magnésio constitui o medicamento de primeira linha para o tratamento e prevenção das crises convulsivas na eclâmpsia. O protocolo terapêutico preconiza dose inicial de 4 a 6 gramas por via endovenosa administrada em 20 minutos, posteriormente mantida com infusão contínua de 1 a 2 gramas por hora durante 24 horas após a última crise ou após o nascimento. Durante o tratamento, torna-se fundamental o acompanhamento clínico rigoroso, incluindo avaliação dos reflexos tendinosos profundos, controle do débito urinário e monitorização da frequência respiratória, considerando o potencial risco de toxicidade medicamentosa.",
    "images": [],
    "correctAnswer": "A",
    "isAnulada": false,
    "source": "questmed"
  },
  {
    "id": "e49ab733-004b-43a5-9371-cf1032e769e9",
    "code": "UFPIHUUFPI-2017-OBS-6714",
    "institution": "UFPI/HU-UFPI - Hospital Universitário do Piauí - Teresina (PI)",
    "banca": "UFPI/HU-UFPI",
    "year": 2017,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Abortamento",
    "foco": "Abortamento de Repetição",
    "subfoco": "Causas Anatômicas Uterinas e Cervicais",
    "difficulty": "Fácil",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "Representa uma causa de abortamento com tendência a repetição após 12 semanas.",
    "options": [
      {
        "letter": "A",
        "text": "Toxoplasmose."
      },
      {
        "letter": "B",
        "text": "Rubéola."
      },
