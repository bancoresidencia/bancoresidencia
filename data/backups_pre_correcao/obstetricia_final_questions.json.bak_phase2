  {
    "id": "d32c3775-6fcb-4113-88fb-3c15f554bef2",
    "code": "USPHCRP-2021-OBS-2996",
    "institution": "USP/HCRP - Hospital das Clínicas de Ribeirão Preto (SP)",
    "banca": "USP/HCRP",
