      {
        "letter": "C",
        "text": "Solicitar beta-hCG."
      },
      {
        "letter": "D",
        "text": "Iniciar doxiciclina oral e manter por 10 dias."
      },
      {
        "letter": "E",
        "text": "Ultrassonografia abdominal."
      }
    ],
    "correct_answer": "C",
