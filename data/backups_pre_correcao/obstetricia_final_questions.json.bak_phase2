  {
    "id": "1ac9d57f-5f58-4800-9dc1-b436e1acfe2f",
    "code": "UNICAMPHC-2014-OBS-13193",
    "institution": "UNICAMP/HC - Hospital de Clínicas da Unicamp - Campinas (SP)",
