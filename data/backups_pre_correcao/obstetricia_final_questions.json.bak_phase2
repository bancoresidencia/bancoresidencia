  {
    "id": "26f265e8-c6a5-49d5-8064-651edd8c633f",
    "code": "SANTACASADEA-2024-OBS-10123",
    "institution": "Santa Casa de Alfenas - Casa de Caridade (MG)",
    "banca": "Santa Casa de Alfenas",
    "year": 2024,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
