    "id": "14281471-d78c-423e-ad93-a3887e1195a1",
    "code": "UFPBHULW-2023-OBS-7294",
    "institution": "UFPB/HULW - Hospital Universitário Lauro Wanderley - João Pessoa (PB)",
    "banca": "UFPB/HULW",
