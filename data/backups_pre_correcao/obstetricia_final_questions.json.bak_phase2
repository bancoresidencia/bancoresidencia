  {
    "id": "4900a6ac-a0b6-4a06-8851-76d3bf1e8d9e",
    "code": "UNIFESPEPM-2026-OBS-7702",
    "institution": "UNIFESP/EPM - Universidade Federal de São Paulo - Escola Paulista de Medicina (SP)",
    "banca": "UNIFESP/EPM",
    "year": 2026,
    "tipo_prova": "Prova 1",
    "modalidade": "Residência Médica",
    "especialidade": "Obstetrícia",
    "tema": "Abortamento",
    "foco": "Gravidez Ectópica",
    "subfoco": "Diagnóstico por Imagem e β-hCG",
    "difficulty": "Médio",
    "type": "Múltipla escolha",
    "is_anulada": false,
    "statement": "Mulher, 29 anos de idade, refere atraso menstrual há 6 semanas e sangramento genital em pequena quantidade há 1 dia. Exame físico: estável hemodinamicamente, abdome indolor e ao toque útero e anexos normais, colo impérvio. Realizou beta-hCG com valor de 750 mUI/mL e ultrassonografia transvaginal com eco endometrial de 8 mm e cisto com conteúdo anecoico em ovário direito medindo 30x20 mm com presença de halo vascular ao Doppler. Repetiu o beta-hCG em 48h com valor de 937 mUI/mL e a ultrassonografia inalterada. Qual é o diagnóstico mais provável?",
    "options": [
      {
        "letter": "A",
        "text": "Gravidez incipiente."
      },
      {
        "letter": "B",
        "text": "Gravidez inviável."
      },
      {
        "letter": "C",
        "text": "Tumor de sitio placentário."
      },
      {
        "letter": "D",
        "text": "Teratoma ovariano."
      }
    ],
    "correct_answer": "B",
    "commentary": "Gabarito Oficial [UNIFESP 2026 Q#49]: Correta. Gravidez ectópica íntegra. O cisto anecoico de 3x20mm com halo vascular ao Doppler é altamente sugestivo de gravidez tubária. O beta-hCG com elevação inadequada em 48h (de 750 para 937 mUI/ml - aumento de apenas 25% ao invés dos 66% esperados) é clássico de prova para ectópica. Paciente estável hemodinamicamente confirma que ainda não houve rotura.",
    "images": [],
    "correctAnswer": "B",
    "isAnulada": false,
    "source": "questmed"
  },
