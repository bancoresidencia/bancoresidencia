        "letter": "B",
        "text": "Internar a paciente para observação"
      },
      {
        "letter": "C",
        "text": "Encaminhar para pré-natal de alto risco"
      },
      {
        "letter": "D",
        "text": "Prescrever beta-agonista para relaxamento uterino"
      }
    ],
    "correct_answer": "A",
