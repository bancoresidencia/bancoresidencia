  {
    "id": "bb16d8fc-5621-4ddd-8c9d-71ce0ff18b9a",
    "code": "IFFFIOCRUZ-2026-OBS-13380",
    "institution": "IFF/Fiocruz - Instituto Fernandes Figueira (RJ)",
