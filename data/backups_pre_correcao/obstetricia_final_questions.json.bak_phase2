      "https://bxedpdmgvgatjdfxgxij.supabase.co/storage/v1/object/public/questoes/revalida/2025/gestante-37-semanas-com-doenca-hipertensiva-especifica-da-ge-01.webp"
    ],
    "correctAnswer": "B",
    "is_official": true,
    "provenance": "oficial_drive_tematico",
    "official_book": "Vitalidade Fetal.pdf.json"
  },
