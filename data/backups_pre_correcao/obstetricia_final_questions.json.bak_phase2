  {
    "id": "112576f7-9cad-46bb-a574-d969d3d2e1a7",
    "code": "USPHCRP-2026-OBS-13103",
    "institution": "USP/HCRP - Hospital das Clínicas de Ribeirão Preto (SP)",
    "banca": "USP/HCRP",
    "year": 2026,
    "tipo_prova": "Prova 1",
