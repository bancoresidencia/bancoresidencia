  {
    "id": "3ee90131-a413-40c6-98bd-a9e950c31198",
    "code": "UFRGSHCPA-2020-OBS-11764",
    "institution": "UFRGS/HCPA - Hospital de Clínicas de Porto Alegre (RS)",
    "banca": "UFRGS/HCPA",
